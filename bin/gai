CHECKSUM_NAME = "SHA512-SUMS.txt"

# (system, machine) -> (release asset suffix, member in the zip, installed name, is app bundle)
RELEASES = {
    ("linux", "x86_64"): ("linux.x86_64.zip", "Godot_v{tag}_linux.x86_64", "godot", False),
    ("linux", "amd64"): ("linux.x86_64.zip", "Godot_v{tag}_linux.x86_64", "godot", False),
    ("darwin", "x86_64"): ("macos.universal.zip", "Godot.app/Contents/MacOS/Godot", "Godot.app", True),
    ("darwin", "arm64"): ("macos.universal.zip", "Godot.app/Contents/MacOS/Godot", "Godot.app", True),
    ("windows", "amd64"): ("win64.exe.zip", "Godot_v{tag}_win64.exe", "godot.exe", False),
}

ERROR_LINE = re.compile(r"^(?:ERROR|SCRIPT ERROR|SHADER ERROR):")


def die(message: str, code: int = 1) -> None:
    print(f"gai: {message}", file=sys.stderr)
    raise SystemExit(code)


def show_path(path: Path) -> str:
    try:
        return str(path.relative_to(ROOT))
    except ValueError:
        return str(path)


def run(argv, **kwargs):
    return subprocess.run([str(item) for item in argv], **kwargs)


def git(*args: str, check: bool = True):
    result = subprocess.run(
        ["git", "-C", str(ROOT), *args],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if check and result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()
        die(f"git {' '.join(args)} failed: {detail}")
    return result


def load_upstream() -> dict:
    try:
        state = json.loads(UPSTREAM_FILE.read_text(encoding="utf-8"))
    except FileNotFoundError:
        die("`.gai/upstream.json` is missing")
    except json.JSONDecodeError as exc:
        die(f"`.gai/upstream.json` is not valid JSON: {exc}")
    return state


def save_upstream(state: dict) -> None:
    UPSTREAM_FILE.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")


def gai_version() -> str:
    try:
        return VERSION_FILE.read_text(encoding="utf-8").strip()
    except FileNotFoundError:
        return "unknown"


def built_engine():
    bin_path = ROOT / "bin"
    if not bin_path.is_dir():
        return None
    found = [
        path
        for path in bin_path.iterdir()
        if path.is_file()
        and path.name.startswith("godot.")
        and ".editor." in path.name
        and ".console." not in path.name
        and not path.name.endswith(".debug")
    ]
    if not found:
        return None
    found.sort(key=lambda path: path.stat().st_mtime, reverse=True)
    return found[0]


def built_template(target: str = "template_release", platform_name=None):
    bin_path = ROOT / "bin"
    if not bin_path.is_dir():
        return None
    found = []
    for path in bin_path.iterdir():
        if not path.is_file() or not path.name.startswith("godot."):
            continue
        if f".{target}." not in path.name or ".console." in path.name:
            continue
        if path.name.endswith(".debug"):
            continue
        if platform_name and platform_name != "host":
            flag = "linuxbsd" if platform_name == "linuxbsd" else platform_name
            if f".{flag}." not in path.name:
                continue
        found.append(path)
    if not found:
        return None
    found.sort(key=lambda path: path.stat().st_mtime, reverse=True)
    return found[0]


def installed_engine():
    for candidate in (
        BIN_DIR / "godot",
        BIN_DIR / "godot.exe",
        BIN_DIR / "Godot.app" / "Contents" / "MacOS" / "Godot",
    ):
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return candidate
    return None


def find_engine():
    candidates = []
    override = os.environ.get("GAI_GODOT")
    if override:
        candidates.append(Path(override).expanduser())
    built = built_engine()
    if built:
        candidates.append(built)
    candidates.extend(
        [
            BIN_DIR / "godot",
            BIN_DIR / "godot.exe",
            BIN_DIR / "Godot.app" / "Contents" / "MacOS" / "Godot",
        ]
    )
    for name in ("godot", "godot4"):
        located = shutil.which(name)
        if located:
            candidates.append(Path(located))
    for candidate in candidates:
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return candidate
    return None


def require_engine() -> Path:
    engine = find_engine()
    if engine is None:
        die(
            "no engine found. Run `bin/gai bootstrap` to build it, "
            "or `bin/gai engine install` for the official fallback."
        )
    ensure_steam_runtime(engine)
    return engine


def steam_library():
    system = platform.system()
    machine = platform.machine().lower()
    if system == "Linux":
        folder = "linuxarm64" if machine in ("aarch64", "arm64") else "linux64"
        name = "libsteam_api.so"
    elif system == "Darwin":
        folder, name = "osx", "libsteam_api.dylib"
    elif system == "Windows":
        folder, name = "win64", "steam_api64.dll"
    else:
        return None
    path = STEAM_SDK / "redistributable_bin" / folder / name
    return path if path.is_file() else None


def steam_sdk_ready() -> bool:
    return (STEAM_SDK / "public" / "steam" / "steam_api_flat.h").is_file()


def steam_sdk_version():
    readme = STEAM_SDK / "Readme.txt"
    if not readme.is_file():
        return None
    match = re.search(r"^v([0-9.]+)", readme.read_text(encoding="utf-8", errors="replace"), re.MULTILINE)
    return match.group(1) if match else None


def engine_has_steam(engine) -> bool:
    needle = b"steamInitEx"
    tail = b""
    try:
        with engine.open("rb") as handle:
            while True:
                chunk = handle.read(1 << 20)
                if not chunk:
                    return False
                if needle in tail + chunk:
                    return True
                tail = chunk[-len(needle):]
    except OSError:
        return False


def ensure_steam_runtime(engine) -> None:
    source = steam_library()
    if source is None or BIN_DIR in engine.parents:
        return
    target = engine.parent / source.name
    try:
        if target.is_file() and target.stat().st_size == source.stat().st_size:
            return
        shutil.copy2(source, target)
    except OSError as error:
        print(f"gai: could not copy {source.name} next to the engine: {error}", file=sys.stderr)


def steam_sdk_source(value: str, workdir: Path):
    source = Path(value).expanduser()
    if source.is_file() and zipfile.is_zipfile(source):
        with zipfile.ZipFile(source) as archive:
            archive.extractall(workdir / "sdk")
        source = workdir / "sdk"
    if not source.is_dir():
        die(f"not a directory or zip: {value}")
    candidates = [source, *(child for child in source.iterdir() if child.is_dir())]
    for candidate in candidates:
        if (candidate / "public" / "steam" / "steam_api_flat.h").is_file():
            return candidate
    die(f"no Steamworks SDK found in {value}. Keep the zip intact, or point at the folder that holds `public/`.")


def install_steam_sdk(source: Path) -> None:
    STEAM_SDK.mkdir(parents=True, exist_ok=True)
    for name in ("public", "redistributable_bin"):
        target = STEAM_SDK / name
        if target.exists():
            shutil.rmtree(target)
        shutil.copytree(source / name, target)
    for name in ("Readme.txt", "steam_api.h"):
        candidate = source / name
        if candidate.is_file():
            shutil.copy2(candidate, STEAM_SDK / name)
    version = steam_sdk_version() or "unknown"
    if version not in ("unknown", STEAM_SDK_VERSION):
        print(f"gai: warning: SDK {version} is not the expected {STEAM_SDK_VERSION}")
    library = steam_library()
    print(f"gai: Steamworks SDK {version} installed in {STEAM_SDK.relative_to(ROOT)}")
    if library is None:
        print("gai: this SDK has no library for this platform")
    else:
        print(f"gai: runtime library {library.relative_to(ROOT)}")
    print("gai: rebuild the engine to include Steam")


def cmd_steam_status(args) -> int:
    commit = "unknown"
    upstream = STEAM_DIR / "UPSTREAM.md"
    if upstream.is_file():
        match = re.search(r"commit\s+`([0-9a-f]+)`", upstream.read_text(encoding="utf-8"))
        if match:
            commit = match.group(1)[:8]
    print(f"module {STEAM_DIR.relative_to(ROOT)} (upstream {commit})")
    print(f"sdk {'yes' if steam_sdk_ready() else 'missing'}")
    if steam_sdk_ready():
        print(f"sdk version {steam_sdk_version() or 'unknown'}")
        library = steam_library()
        print(f"sdk library {library.relative_to(ROOT) if library else 'missing for this platform'}")
    engine = find_engine()
    if engine is not None:
        library = steam_library()
        present = library is not None and (engine.parent / library.name).is_file()
        print(f"engine {engine}")
        print(f"engine built with steam {'yes' if engine_has_steam(engine) else 'no'}")
        print(f"runtime library {'yes' if present else 'no'}")
    if not steam_sdk_ready():
        print("next: bin/gai steam sdk --download")
        return 1
    return 0


def cmd_steam_sdk(args) -> int:
    print("gai: the Steamworks SDK is Valve's and is covered by the Steamworks SDK license.")
    print("gai: gai does not redistribute it. Using the SDK means you accept Valve's terms.")
    if args.download:
        with tempfile.TemporaryDirectory() as temp:
            workdir = Path(temp)
            archive = workdir / "sdk.tar.gz"
            print(f"gai: downloading Steamworks SDK {STEAM_SDK_VERSION} from the pinned mirror")
            try:
                with urllib.request.urlopen(STEAM_SDK_URL, timeout=120) as response:
                    data = response.read()
                digest = hashlib.sha256(data).hexdigest()
                if digest != STEAM_SDK_SHA256:
                    die(f"the downloaded SDK has the wrong checksum: {digest}")
                archive.write_bytes(data)
            except OSError as error:
                die(f"download failed: {error}. Use `--from` with an SDK you downloaded from Valve.")
            with tarfile.open(archive, "r:gz") as bundle:
                try:
                    bundle.extractall(workdir / "unpacked", filter="data")
                except TypeError:
                    bundle.extractall(workdir / "unpacked")
            source = next((path for path in (workdir / "unpacked").iterdir() if path.is_dir()), None)
            if source is None:
                die("the downloaded archive is empty")
            install_steam_sdk(source)
    elif args.from_path:
        with tempfile.TemporaryDirectory() as temp:
            install_steam_sdk(steam_sdk_source(args.from_path, Path(temp)))
    else:
        die("pass `--download` or `--from <path>`")
    return 0


def cmd_steam_runtime(args) -> int:
    engine = find_engine()
    if engine is None:
        die("no engine found. Run `bin/gai bootstrap` first.")
    ensure_steam_runtime(engine)
    library = steam_library()
    if library is None:
        die("no Steamworks runtime library for this platform")
    print(f"gai: {library.name} is next to {engine}")
    return 0


def cmd_steam_vendor(args) -> int:
    source = Path(args.from_path).expanduser()
    if not source.is_dir():
        die(f"not a directory: {source}")
    patch_tool = shutil.which("patch")
    if patch_tool is None:
        die("`patch` is not installed")
    with tempfile.TemporaryDirectory() as temp:
        staging = Path(temp) / "module"
        staging.mkdir()
        for name in STEAM_FILES:
            candidate = source / name
            if candidate.is_file():
                shutil.copy2(candidate, staging / name)
        if (source / "doc_classes").is_dir():
            shutil.copytree(source / "doc_classes", staging / "doc_classes")
        patch_file = STEAM_DIR / "gai.patch"
        result = subprocess.run(
            [patch_tool, "-p1", "--forward", "-i", str(patch_file)],
            cwd=staging,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
        )
        if result.returncode != 0:
            die(f"`gai.patch` does not apply. Update it, then run the command again.\n{result.stdout.strip()}")
        for name in STEAM_FILES:
            candidate = staging / name
            if candidate.is_file():
                shutil.copy2(candidate, STEAM_DIR / name)
        target = STEAM_DIR / "doc_classes"
        if (staging / "doc_classes").is_dir():
            if target.exists():
                shutil.rmtree(target)
            shutil.copytree(staging / "doc_classes", target)
    commit = subprocess.run(
        ["git", "-C", str(source), "rev-parse", "HEAD"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    ).stdout.strip()
    readme = STEAM_DIR / "UPSTREAM.md"
    if readme.is_file() and commit:
        text = readme.read_text(encoding="utf-8")
        text = re.sub(r"(commit\s+`)[0-9a-f]+(`)", rf"\g<1>{commit}\g<2>", text, count=1)
        readme.write_text(text, encoding="utf-8")
    print(f"gai: vendored GodotSteam {commit[:8] if commit else 'from a plain directory'}")
    command = " ".join(str(part) for part in build_engine_command())
    print(f"gai: rebuild with `{command}`")
    return 0


def engine_version(engine: Path):
    try:
        result = run(
            [engine, "--version"],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if result.returncode != 0:
        return None
    lines = result.stdout.strip().splitlines()
    return lines[0] if lines else None


def require_game() -> None:
    project = GAME_DIR / "project.godot"
    if not project.is_file():
        die(f"`{show_path(project)}` is missing. Point `GAI_GAME` at a Godot project, or restore the starter game from git.")


def numeric_version(text: str):
    match = re.match(r"(\d+(?:\.\d+)*)", text)
    if not match:
        return None
    return tuple(int(part) for part in match.group(1).split("."))


def source_version():
    try:
        text = (ROOT / "version.py").read_text(encoding="utf-8")
    except OSError:
        return None
    values = {}
    for key in ("major", "minor", "patch"):
        match = re.search(rf"^{key} = (\d+)$", text, re.MULTILINE)
        if not match:
            return None
        values[key] = int(match.group(1))
    return (values["major"], values["minor"], values["patch"])


def version_problems(engine: Path, state: dict):
    problems = []
    version = engine_version(engine)
    expected = numeric_version(state["tag"])
    actual = numeric_version(version or "")
    if not version:
        problems.append("the engine did not report a version")
    elif not expected or not actual or actual[: len(expected)] != expected:
        problems.append(
            f"engine {version} does not match upstream {state['tag']}; "
            "rebuild the source engine, or run `bin/gai engine install --force` for the fallback"
        )

    source = source_version()
    if source is None:
        problems.append("cannot read major, minor, and patch from `version.py`")
    elif not expected or source[: len(expected)] != expected:
        problems.append(
            f"`version.py` is {'.'.join(map(str, source))} and upstream is {state['tag']}; "
            "fix `version.py`"
        )
    return problems


def release_for_host():
    system = platform.system().lower()
    machine = platform.machine().lower()
    key = (system, machine)
    if key not in RELEASES:
        die(
            f"no official Godot binary for {system}/{machine}. Build from source "
            "(`docs/gai/build.md`) and point `GAI_GODOT` at the binary."
        )
    return RELEASES[key]


def sha512_of(path: Path) -> str:
    digest = hashlib.sha512()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def expected_checksum(asset: str, tag: str) -> str:
    url = RELEASE_BASE.format(tag=tag, name=CHECKSUM_NAME)
    try:
        with urllib.request.urlopen(url, timeout=60) as response:
            text = response.read().decode("utf-8", errors="replace")
    except OSError as exc:
        die(f"cannot download {url}: {exc}")
    for line in text.splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[1].lstrip("*") == asset:
            return parts[0].lower()
    die(f"{asset} is not listed in {url}")


def download(url: str, target: Path) -> None:
    request = urllib.request.Request(url, headers={"User-Agent": "gai"})
    try:
        with urllib.request.urlopen(request, timeout=300) as response:
            with target.open("wb") as handle:
                shutil.copyfileobj(response, handle)
    except OSError as exc:
        die(f"download failed: {exc}")


def extract_member(archive: Path, member: str, target: Path) -> None:
    with zipfile.ZipFile(archive) as bundle:
        try:
            data = bundle.read(member)
        except KeyError:
            die(f"`{member}` is not in {archive.name}")
    target.write_bytes(data)
    target.chmod(0o755)


def extract_tree(archive: Path, source: str, target: Path) -> None:
    staging = target.parent / (target.name + ".tmp")
    shutil.rmtree(staging, ignore_errors=True)
    try:
        with zipfile.ZipFile(archive) as bundle:
            for info in bundle.infolist():
                name = Path(info.filename)
                if name.is_absolute() or ".." in name.parts:
                    die(f"refusing unsafe zip member: {info.filename}")
            bundle.extractall(staging)
        app = staging / source
        if not app.exists():
            die(f"`{source}` is not in {archive.name}")
        shutil.move(str(app), str(target))
    finally:
        shutil.rmtree(staging, ignore_errors=True)
    binary = target / "Contents" / "MacOS" / "Godot"
    if binary.exists():
        binary.chmod(0o755)


def cmd_engine_install(args) -> int:
    state = load_upstream()
    tag = state["tag"]
    suffix, member_template, installed, is_bundle = release_for_host()
    asset = f"Godot_v{tag}_{suffix}"
    member = member_template.format(tag=tag)
    target = BIN_DIR / installed

    if target.exists() and not args.force:
        die(f"`{target}` already exists. Use `--force` to replace it.")

    BIN_DIR.mkdir(parents=True, exist_ok=True)
    work = Path(tempfile.mkdtemp(prefix=".install-", dir=str(GAI_DIR)))
    try:
        archive = work / asset
        print(f"downloading {asset}", flush=True)
        download(RELEASE_BASE.format(tag=tag, name=asset), archive)
        print("verifying sha512", flush=True)
        actual = sha512_of(archive)
        expected = expected_checksum(asset, tag)
        if actual != expected:
            die(f"checksum mismatch for {asset}\n  expected {expected}\n  actual   {actual}")

        if is_bundle:
            if target.exists():
                shutil.rmtree(target)
            extract_tree(archive, "Godot.app", target)
            binary = target / "Contents" / "MacOS" / "Godot"
        else:
            staging = work / "staged"
            extract_member(archive, member, staging)
            if target.exists():
                target.unlink()
            shutil.move(str(staging), str(target))
            binary = target
    finally:
        shutil.rmtree(work, ignore_errors=True)

    version = engine_version(binary)
    print(f"installed {binary}")
    print(f"engine {version or 'unknown'}")
    return 0


def cmd_engine_path(args) -> int:
    print(require_engine())
    return 0


def build_jobs() -> int:
    cpus = os.cpu_count() or 2
    try:
        mem_gb = os.sysconf("SC_PAGE_SIZE") * os.sysconf("SC_PHYS_PAGES") / (1024 ** 3)
    except (AttributeError, ValueError, OSError):
        mem_gb = 4
    return max(1, min(cpus, int(mem_gb / 1.5)))


ENGINE_SOURCE_SUFFIXES = {
    ".c", ".cc", ".cpp", ".cxx", ".h", ".hh", ".hpp", ".hxx", ".inc",
    ".m", ".mm", ".S", ".glsl", ".gdshader", ".cs", ".py",
}
ENGINE_BUILD_NAMES = {
    "SConstruct", "SCsub", "config.py", "version.py", "methods.py",
    "platform_methods.py",
}
ENGINE_SKIP_DIRS = {"bin", "game", "docs", "tests", "build", "node_modules", "__pycache__"}


def _is_engine_source(path: Path) -> bool:
    if ".gen." in path.name or path.name.endswith(".gen"):
        return False
    if path.name in ENGINE_BUILD_NAMES or path.name.endswith("_builders.py"):
        return True
    return path.suffix in ENGINE_SOURCE_SUFFIXES


def newest_engine_source():
    newest = None
    for dirpath, dirnames, filenames in os.walk(ROOT):
        dirnames[:] = [
            name
            for name in dirnames
            if name not in ENGINE_SKIP_DIRS and not name.startswith(".")
        ]
        for name in filenames:
            path = Path(dirpath) / name
            if not _is_engine_source(path):
                continue
            try:
                mtime = path.stat().st_mtime
            except OSError:
                continue
            if newest is None or mtime > newest[1]:
                newest = (path, mtime)
    return newest


def build_is_stale(engine):
    newest = newest_engine_source()
    if engine is None or not engine.is_file():
        return True, newest
    if newest is None:
        return False, None
    return newest[1] > engine.stat().st_mtime, newest


def build_engine_command(jobs=None, target: str = "editor", platform_name=None, mingw: bool = False):
    system = platform.system()
    if platform_name is None or platform_name == "host":
        if system == "Linux":
            platform_flag = "linuxbsd"
        elif system == "Darwin":
            platform_flag = "macos"
        elif system == "Windows":
            platform_flag = "windows"
        else:
            die(f"no build recipe for {system}. Read `docs/gai/build.md`.")
    else:
        platform_flag = platform_name
    if platform_flag not in ("linuxbsd", "windows", "macos"):
        die(f"unknown platform: {platform_flag}. Use linuxbsd, windows, or macos.")
    command = ["scons", f"platform={platform_flag}", f"target={target}"]
    command.append("dev_build=no")
    if platform_flag == "linuxbsd":
        command.append("accesskit=no")
        if shutil.which("ld.lld"):
            command.append("linker=lld")
    if platform_flag == "windows":
        if mingw:
            command += ["use_mingw=yes", "d3d12=no", "winrt=no", "accesskit=no", "angle=no"]
        else:
            command += ["accesskit=no"]
    if platform_flag == "macos" and mingw:
        die("--mingw applies to the Windows platform only.")
    command.append(f"-j{max(1, int(jobs)) if jobs is not None else build_jobs()}")
    return command


def cmd_build(args) -> int:
    if args.jobs is not None and args.jobs < 1:
        print("gai: --jobs must be at least 1", file=sys.stderr)
        return 2
    target = getattr(args, "target", "editor")
    platform_name = getattr(args, "platform", "host")
    mingw = getattr(args, "mingw", False)
    if mingw and platform_name != "windows":
        print("gai: --mingw needs --platform windows", file=sys.stderr)
        return 2
    editor_target = target == "editor"
    if editor_target:
        engine = built_engine()
    else:
        engine = built_template(target, platform_name)
    stale, newest = build_is_stale(engine)
    if args.check:
        if engine is None:
            print(f"build: no {target} binary")
            return 1
        if stale:
            source = show_path(newest[0]) if newest else "unknown"
            print(f"build: stale ({source})")
            return 1
        print("build: up to date")
        return 0

    command = build_engine_command(args.jobs, target, platform_name, mingw)
    if args.dry_run:
        print(" ".join(str(part) for part in command))
        return 0
    if not args.force and not stale:
        print("build: up to date")
        return 0
    if shutil.which("scons") is None:
        die(
            "SCons is not installed. Install SCons and the platform build "
            "dependencies from `docs/gai/build.md`."
        )
    if mingw and shutil.which("x86_64-w64-mingw32-g++") is None:
        die("MinGW is missing. Install mingw-w64, then run the build again.")
    if not steam_sdk_ready():
        print("gai: Steam is not in this build. Run `bin/gai steam sdk --download` for a Steam build.", flush=True)
    if newest is not None:
        print(f"build: newer source {show_path(newest[0])}", flush=True)
    print("build: " + " ".join(str(part) for part in command), flush=True)
    print("build: the first build can take 20 to 70 minutes", flush=True)
    started = time.time()
    result = run(command, cwd=ROOT)
    if result.returncode != 0:
        print(f"build: failed after {time.time() - started:.1f}s")
        return 1
    if editor_target and getattr(args, "clean_import", False):
        shutil.rmtree(GAME_DIR / ".godot", ignore_errors=True)
    if editor_target:
        engine = built_engine()
    else:
        engine = built_template(target, platform_name)
    if engine is not None:
        # SCons uses content signatures; a no-op source rewrite leaves the
        # binary older than the source and looks stale to a mtime check.
        try:
            os.utime(engine, None)
        except OSError:
            pass
    print(f"build: ok ({time.time() - started:.1f}s)")
    if engine is not None:
        print(f"engine: {engine}")
    return 0


def cmd_bootstrap(args) -> int:
    state = load_upstream()
    if args.official:
        engine = installed_engine()
        if engine is None:
            print("gai: installing the official fallback engine", flush=True)
            result = cmd_engine_install(argparse.Namespace(force=False))
            if result != 0:
                return result
            engine = installed_engine()
            if engine is None:
                die("the install finished but no engine binary was found")
    else:
        override = os.environ.get("GAI_GODOT")
        if override:
            engine = Path(override).expanduser()
            if not engine.is_file() or not os.access(engine, os.X_OK):
                die(f"`GAI_GODOT` is not an executable file: {override}")
        else:
            engine = built_engine()
            stale, newest = build_is_stale(engine)
            if engine is None or stale or getattr(args, "rebuild", False):
                result = cmd_build(
                    argparse.Namespace(
                        force=getattr(args, "rebuild", False),
                        check=False,
                        dry_run=False,
                        jobs=None,
                        target="editor",
                        platform="host",
                        mingw=False,
                        clean_import=False,
                    )
                )
                if result != 0:
                    return result
                engine = built_engine()
                if engine is None:
                    die("the build finished but no editor binary was found in `bin/`")

    print(f"gai: engine {engine_version(engine) or 'unknown'}", flush=True)
    os.environ["GAI_GODOT"] = str(engine)
    if engine and BIN_DIR not in engine.parents:
        if not steam_sdk_ready():
            print("gai: Steam is not in this build. Run `bin/gai steam sdk --download`, then `bin/gai bootstrap` again.", flush=True)
        elif not engine_has_steam(engine):
            command = " ".join(str(part) for part in build_engine_command())
            print(f"gai: the Steamworks SDK is installed but this engine predates it. Rebuild with `{command}`.", flush=True)

    problems = version_problems(engine, state)
    downloaded = BIN_DIR in engine.parents
    if problems and downloaded and any(problem.startswith("engine ") for problem in problems):
        print("gai: fallback engine does not match; reinstalling", flush=True)
        result = cmd_engine_install(argparse.Namespace(force=True))
        if result != 0:
            return result
        engine = installed_engine()
        if engine is None:
            die("the install finished but no engine binary was found")
        os.environ["GAI_GODOT"] = str(engine)
        problems = version_problems(engine, state)

    if problems:
        print("gai: engine or version.py does not match the recorded upstream base")
        for problem in problems:
            print(f"  {problem}")
        print("Run `bin/gai doctor` to see the engine path. Rebuild a source engine, or run `bin/gai engine install --force` for the fallback.")
        return 1

    require_game()
    return cmd_check(argparse.Namespace(frames=5, timeout=120, scene=[], no_tests=False))


SHUTDOWN_ERRORS = (
    "resources still in use at exit",
)


def collect_errors(text: str):
    found = []
    for line in text.splitlines():
        stripped = line.strip()
        if ERROR_LINE.match(stripped) and stripped not in found:
            if any(known in stripped for known in SHUTDOWN_ERRORS):
                continue
            found.append(stripped)
    return found


TEST_RESULT_PREFIX = "GAI_TEST_RESULT "
TEST_LIST_PREFIX = "GAI_TEST_LIST "


def parse_test_result(text: str):
    for line in reversed(text.splitlines()):
        if not line.startswith(TEST_RESULT_PREFIX):
            continue
        try:
            value = json.loads(line[len(TEST_RESULT_PREFIX) :])
        except json.JSONDecodeError:
            return None
        return value if isinstance(value, dict) else None
    return None


def write_test_junit(summary, path: Path) -> None:
    results = summary.get("results", []) if isinstance(summary, dict) else []
    if not isinstance(results, list):
        results = []
    failures = sum(1 for item in results if item.get("status") == "fail")
    skipped = sum(1 for item in results if item.get("status") == "pending")
    duration = float(summary.get("duration_ms", 0)) / 1000.0 if isinstance(summary, dict) else 0.0
    lines = [
        '<?xml version="1.0" encoding="UTF-8"?>',
        "<testsuite name={} tests=\"{}\" failures=\"{}\" skipped=\"{}\" time=\"{:.3f}\">".format(
            quoteattr("gai"),
            len(results),
            failures,
            skipped,
            duration,
        ),
    ]
    for item in results:
        if not isinstance(item, dict):
            continue
        classname = str(item.get("file", ""))
        name = str(item.get("name", ""))
        seconds = float(item.get("duration_ms", 0)) / 1000.0
        lines.append(
            "  <testcase classname={} name={} time=\"{:.3f}\">".format(
                quoteattr(classname),
                quoteattr(name),
                seconds,
            )
        )
        for failure in item.get("failures", []) or []:
            message = str(failure)
            lines.append(
                "    <failure message={}>{}</failure>".format(
                    quoteattr(message),
                    escape(message),
                )
            )
        if item.get("status") == "pending":
            reason = str(item.get("pending", ""))
            lines.append("    <skipped message={}/>".format(quoteattr(reason)))
        lines.append("  </testcase>")
    lines.append("</testsuite>")
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def parse_test_list(text: str):
    for line in reversed(text.splitlines()):
        if not line.startswith(TEST_LIST_PREFIX):
            continue
        try:
            value = json.loads(line[len(TEST_LIST_PREFIX) :])
        except json.JSONDecodeError:
            return None
        return value if isinstance(value, list) else None
    return None


def test_failure_lines(summary, limit: int = 12):
    lines = []
    if not isinstance(summary, dict):
        return lines
    results = summary.get("results")
    if not isinstance(results, list):
        return lines
    for item in results:
        if not isinstance(item, dict):
            continue
        if item.get("status") != "fail":
            continue
        failures = item.get("failures") or ["failed"]
        detail = "; ".join(str(failure) for failure in failures)
        lines.append(f"{item.get('file', '?')}::{item.get('name', '?')}: {detail}")
        if len(lines) >= limit:
            break
    return lines


def project_autoloads() -> list[str]:
    project = GAME_DIR / "project.godot"
    try:
        lines = project.read_text(encoding="utf-8").splitlines()
    except OSError:
        return []
    names = []
    section = ""
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            section = stripped[1:-1]
        elif section == "autoload" and "=" in stripped and not stripped.startswith(";") and not stripped.startswith("#"):
            name = stripped.split("=", 1)[0].strip()
            if name:
                names.append(name)
    return names


SCRIPT_CHECKER = """extends Node


func _ready() -> void:
	var files: Array[String] = []
	_collect("res://", files)
	for path in files:
		load(path)
	print("gai-check: ", files.size(), " scripts")
	get_tree().quit()


func _collect(path: String, out: Array[String]) -> void:
	var dir: DirAccess = DirAccess.open(path)
	if dir == null:
		return
	dir.list_dir_begin()
	var name: String = dir.get_next()
	while name != "":
		if not name.begins_with("."):
			var full: String = path.path_join(name)
			if dir.current_is_dir():
				_collect(full, out)
			elif name.ends_with(".gd"):
				out.append(full)
		name = dir.get_next()
	dir.list_dir_end()
"""

CHECKER_SCENE = """[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://.gai/check/gai_check.gd" id="1"]

[node name="GaiCheck" type="Node"]
script = ExtResource("1")
"""


def write_script_checker() -> str:
    check_dir = GAME_DIR / ".gai" / "check"
    check_dir.mkdir(parents=True, exist_ok=True)
    (check_dir / "gai_check.gd").write_text(SCRIPT_CHECKER, encoding="utf-8")
    (check_dir / "gai_check.tscn").write_text(CHECKER_SCENE, encoding="utf-8")
    return "res://.gai/check/gai_check.tscn"


def remove_script_checker() -> None:
    check_dir = GAME_DIR / ".gai" / "check"
    for name in ("gai_check.gd", "gai_check.tscn"):
        (check_dir / name).unlink(missing_ok=True)
    try:
        check_dir.rmdir()
    except OSError:
        pass


def ensure_game_import(engine, timeout: float, quiet: bool = False) -> bool:
    if (GAME_DIR / ".godot").is_dir():
        return True
    if not quiet:
        print("test: first import", flush=True)
    try:
        run(
            [engine, "--headless", "--path", GAME_DIR, "--import"],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        if not quiet:
            print(f"test: import timed out after {timeout}s")
        return False
    return True


def discover_scene_tests(directories: list[str]) -> list[str]:
    found: list[str] = []
    for directory in directories:
        root = GAME_DIR / directory.removeprefix("res://")
        if not root.is_dir():
            continue
        for path in root.rglob("*.tscn"):
            relative = path.relative_to(GAME_DIR)
            if any(part.startswith(".") for part in relative.parts):
                continue
            scene = "res://" + relative.as_posix()
            if scene not in found:
                found.append(scene)
    return sorted(found)


def cmd_test_scene(engine, args, log_path: Path, junit_path: Path) -> int:
    missing = [directory for directory in args.scene_dir if not (GAME_DIR / directory.removeprefix("res://")).is_dir()]
    if missing:
        for directory in missing:
            print(f"test: no directory {directory}", file=sys.stderr)
        return 1
    if not ensure_game_import(engine, args.timeout, quiet=args.json):
        if args.json:
            print(json.dumps({"error": "import timeout"}))
        return 1

    scenes = discover_scene_tests(args.scene_dir)
    if args.filter:
        needle = args.filter.lower()
        scenes = [scene for scene in scenes if needle in scene.lower()]

    summary = {
        "version": 1,
        "scene_tests": True,
        "dirs": args.scene_dir,
        "filter": args.filter,
        "files": len(scenes),
        "tests": 0,
        "passed": 0,
        "failed": 0,
        "pending": 0,
        "duration_ms": 0,
        "results": [],
    }
    outputs: list[str] = []
    for scene in scenes:
        started = time.time()
        argv = [engine, "--headless", "--path", GAME_DIR]
        if args.scene_frames > 0:
            argv.extend(["--quit-after", str(args.scene_frames)])
        argv.append(scene)
        text = ""
        returncode = None
        timed_out = False
        try:
            result = run(
                argv,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=args.scene_timeout,
            )
            text = result.stdout or ""
            returncode = result.returncode
        except subprocess.TimeoutExpired as exc:
            partial = exc.output or ""
            text = partial.decode("utf-8", errors="replace") if isinstance(partial, bytes) else partial
            timed_out = True
        outputs.append(text)
        if args.verbose:
            print(text.rstrip())

        errors = collect_errors(text)
        failures: list[str] = []
        if timed_out:
            failures.append(f"timed out after {args.scene_timeout}s")
        elif returncode != 0:
            failures.append(f"engine exited with code {returncode}")
        failures.extend(errors)
        status = "fail" if failures else "pass"
        duration = int((time.time() - started) * 1000)
        item = {
            "file": scene,
            "name": Path(scene).stem,
            "status": status,
            "failures": failures,
            "pending": "",
            "duration_ms": duration,
        }
        summary["results"].append(item)
        summary["tests"] += 1
        summary["passed" if status == "pass" else "failed"] += 1
        summary["duration_ms"] += duration
        if not args.json:
            print(f"{status.upper()} scene:{scene} ({duration} ms)")
            for failure in failures:
                print("  " + failure)

    log_path.write_text("".join(outputs), encoding="utf-8")
    write_test_junit(summary, junit_path)
    failed = summary["failed"] > 0
    if args.json:
        print(json.dumps(summary, ensure_ascii=False))
        return 1 if failed else 0
    if not scenes:
        if args.filter:
            print(f"scenes: no scenes matched `{args.filter}`")
        else:
            print("scenes: no scenes in " + ", ".join(args.scene_dir))
        return 1 if args.filter else 0
    print(
        "scenes: %d passed, %d failed (%d ms)"
        % (summary["passed"], summary["failed"], summary["duration_ms"])
    )
    print(f"log: {show_path(log_path)}")
    print(f"junit: {show_path(junit_path)}")
    return 1 if failed else 0


def cmd_test_isolate(engine, args, log_path: Path, junit_path: Path, per_test: bool = False) -> int:
    if args.file_timeout <= 0:
        print("gai: --file-timeout must be positive", file=sys.stderr)
        return 2
    test_root = GAME_DIR / args.dir.removeprefix("res://")
    files: list[Path] = []
    if test_root.is_dir():
        files = sorted(
            path
            for path in test_root.rglob("test_*.gd")
            if not any(part.startswith(".") for part in path.relative_to(test_root).parts)
        )
    targets: list[tuple[str, str]] = []
    if per_test:
        list_argv = [
            engine,
            "--headless",
            "--path",
            GAME_DIR,
            "--script",
            "res://tests/run_tests.gd",
            "--",
            f"--dir={args.dir}",
            "--list",
        ]
        if args.filter:
            list_argv.append(f"--filter={args.filter}")
        try:
            listed = run(
                list_argv,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=args.timeout,
            )
        except subprocess.TimeoutExpired:
            print("test: discovery timed out", file=sys.stderr)
            return 1
        discovery_errors = collect_errors(listed.stdout or "")
        if discovery_errors:
            print("test: discovery found errors", file=sys.stderr)
            for error in discovery_errors[:8]:
                print("  " + error, file=sys.stderr)
            return 1
        parsed = parse_test_list(listed.stdout or "")
        if parsed is None:
            print("test: discovery did not return a test list", file=sys.stderr)
            return 1
        for item in parsed:
            if isinstance(item, dict) and item.get("file") and item.get("name"):
                targets.append((str(item["file"]), str(item["name"])))
        files = [Path(item[0].removeprefix("res://")) for item in targets]
    else:
        for path in files:
            targets.append(("res://" + path.relative_to(GAME_DIR).as_posix(), ""))

    aggregate = {
        "version": 1,
        "dir": args.dir,
        "filter": args.filter,
        "files": len({item[0] for item in targets}),
        "skipped_files": 0,
        "tests": 0,
        "passed": 0,
        "failed": 0,
        "pending": 0,
        "duration_ms": 0,
        "results": [],
        "isolated": True,
    }
    outputs = []
    for relative, method in targets:
        argv = [
            engine,
            "--headless",
            "--path",
            GAME_DIR,
            "--script",
            "res://tests/run_tests.gd",
            "--",
            f"--dir={args.dir}",
            f"--file={relative}",
            "--json",
        ]
        if method:
            argv.append(f"--method={method}")
        if args.filter:
            argv.append(f"--filter={args.filter}")
        started = time.time()
        try:
            result = run(
                argv,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=args.file_timeout,
            )
            text = result.stdout or ""
            summary = parse_test_result(text)
            if summary is None:
                summary = {
                    "version": 1,
                    "results": [
                        {
                            "file": relative,
                            "name": method or "<run>",
                            "status": "fail",
                            "failures": [f"no test result (exit {result.returncode})"],
                            "pending": "",
                            "duration_ms": int((time.time() - started) * 1000),
                        }
                    ],
                    "tests": 1,
                    "passed": 0,
                    "failed": 1,
                    "pending": 0,
                    "duration_ms": int((time.time() - started) * 1000),
                }
        except subprocess.TimeoutExpired as exc:
            partial = exc.output or ""
            if isinstance(partial, bytes):
                partial = partial.decode("utf-8", errors="replace")
            text = partial
            summary = {
                "version": 1,
                "results": [
                    {
                        "file": relative,
                        "name": method or "<timeout>",
                        "status": "fail",
                        "failures": [f"timed out after {args.file_timeout}s"],
                        "pending": "",
                        "duration_ms": int(args.file_timeout * 1000),
                    }
                ],
                "tests": 1,
                "passed": 0,
                "failed": 1,
                "pending": 0,
                "duration_ms": int(args.file_timeout * 1000),
            }
        outputs.append(text)
        if args.verbose:
            print(text.rstrip())
        errors = collect_errors(text)
        if errors:
            summary["results"].append(
                {
                    "file": relative,
                    "name": "<engine>",
                    "status": "fail",
                    "failures": errors[:8],
                    "pending": "",
                    "duration_ms": 0,
                }
            )
            summary["tests"] = int(summary.get("tests", 0)) + 1
            summary["failed"] = int(summary.get("failed", 0)) + 1
        for item in summary.get("results", []):
            aggregate["results"].append(item)
        aggregate["tests"] += int(summary.get("tests", 0))
        aggregate["passed"] += int(summary.get("passed", 0))
        aggregate["failed"] += int(summary.get("failed", 0))
        aggregate["pending"] += int(summary.get("pending", 0))
        aggregate["duration_ms"] += int(summary.get("duration_ms", 0))

    log_path.write_text("".join(outputs), encoding="utf-8")
    write_test_junit(aggregate, junit_path)
    failed = aggregate["failed"] > 0
    if args.json:
        print(json.dumps(aggregate, ensure_ascii=False))
        return 1 if failed else 0
    print(
        "tests: %d passed, %d failed, %d pending (%d ms)"
        % (
            aggregate["passed"],
            aggregate["failed"],
            aggregate["pending"],
            aggregate["duration_ms"],
        )
    )
    for line in test_failure_lines(aggregate):
        print("  " + line)
    print(f"log: {show_path(log_path)}")
    print(f"junit: {show_path(junit_path)}")
    return 1 if failed else 0


def cmd_test(args) -> int:
    engine = require_engine()
    require_game()
    if args.scene_dir:
        if args.isolate or args.isolate_tests:
            print("test: --scene-dir cannot be combined with --isolate", file=sys.stderr)
            return 2
        LOG_DIR.mkdir(parents=True, exist_ok=True)
        return cmd_test_scene(
            engine,
            args,
            LOG_DIR / "scene-test.log",
            LOG_DIR / "scene-test.xml",
        )
    test_dir = args.dir
    if not test_dir.startswith("res://"):
        print("gai: --dir must start with res://", file=sys.stderr)
        return 2
    runner = GAME_DIR / "tests" / "run_tests.gd"
    if not runner.is_file():
        if args.dir != "res://tests":
            print("test: res://tests/run_tests.gd is missing", file=sys.stderr)
            return 1
        if args.json:
            print(
                json.dumps(
                    {
                        "tests": 0,
                        "passed": 0,
                        "failed": 0,
                        "pending": 0,
                        "results": [],
                        "note": "no tests",
                    }
                )
            )
        else:
            print("test: no tests (res://tests/run_tests.gd not found)")
        return 0
    if not (GAME_DIR / test_dir.removeprefix("res://")).is_dir():
        print(f"test: no directory {test_dir}", file=sys.stderr)
        return 1

    LOG_DIR.mkdir(parents=True, exist_ok=True)
    log_path = LOG_DIR / "test.log"
    junit_path = LOG_DIR / "test.xml"
    junit_path.unlink(missing_ok=True)

    if not ensure_game_import(engine, args.timeout, quiet=args.json):
        if args.json:
            print(json.dumps({"error": "import timeout"}))
        return 1

    if args.isolate or args.isolate_tests:
        return cmd_test_isolate(
            engine,
            args,
            log_path,
            junit_path,
            per_test=args.isolate_tests,
        )

    argv = [
        engine,
        "--headless",
        "--path",
        GAME_DIR,
        "--script",
        "res://tests/run_tests.gd",
        "--",
        f"--dir={test_dir}",
    ]
    if args.filter:
        argv.append(f"--filter={args.filter}")
    if args.json:
        argv.append("--json")

    try:
        result = run(
            argv,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=args.timeout,
        )
        text = result.stdout or ""
        returncode = result.returncode
    except subprocess.TimeoutExpired as exc:
        partial = exc.output or ""
        if isinstance(partial, bytes):
            partial = partial.decode("utf-8", errors="replace")
        log_path.write_text(partial, encoding="utf-8")
        if args.json:
            print(json.dumps({"error": "timeout", "log": show_path(log_path)}))
        else:
            print(f"test: timed out after {args.timeout}s")
            print(f"log: {show_path(log_path)}")
        return 1

    log_path.write_text(text, encoding="utf-8")
    summary = parse_test_result(text)
    if summary is not None:
        write_test_junit(summary, junit_path)
    errors = collect_errors(text)
    failed = returncode != 0 or summary is None or bool(errors)
    if summary is not None and int(summary.get("failed", 0)) > 0:
        failed = True

    if args.json:
        payload = summary if summary is not None else {"error": "no test result"}
        if errors:
            payload["engine_errors"] = errors
        print(json.dumps(payload, ensure_ascii=False))
        return 1 if failed else 0

    if args.verbose:
        print(text.rstrip())

    if summary is None:
        print("test: the runner did not print GAI_TEST_RESULT")
        if not args.verbose:
            for line in text.rstrip().splitlines()[-20:]:
                print("  " + line)
    else:
        print(
            "tests: %d passed, %d failed, %d pending (%d ms)"
            % (
                int(summary.get("passed", 0)),
                int(summary.get("failed", 0)),
                int(summary.get("pending", 0)),
                int(summary.get("duration_ms", 0)),
            )
        )
        if args.filter and int(summary.get("tests", 0)) == 0:
            print(f"test: no tests matched `{args.filter}`")
        for line in test_failure_lines(summary):
            print("  " + line)

    if returncode != 0:
        print(f"test: runner exited with code {returncode}")
    if errors:
        print(f"test: {len(errors)} engine error(s)")
        for error in errors[:12]:
            print("  " + error)
        if len(errors) > 12:
            print(f"  ... and {len(errors) - 12} more")
    print(f"log: {show_path(log_path)}")
    if summary is not None:
        print(f"junit: {show_path(junit_path)}")
    return 1 if failed else 0


def cmd_check(args) -> int:
    engine = require_engine()
    require_game()
    state = load_upstream()
    problems = version_problems(engine, state)
    if problems:
        print("check: wrong engine or source version")
        for problem in problems:
            print(f"  {problem}")
        return 1
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    log_path = LOG_DIR / "check.log"
    junit_path = LOG_DIR / "test.xml"
    junit_path.unlink(missing_ok=True)

    fresh_import = not (GAME_DIR / ".godot").is_dir()
    steps = [("import", [engine, "--headless", "--path", GAME_DIR, "--import"], not fresh_import)]
    if fresh_import:
        print("check: first import, load-before-import errors are ignored", flush=True)
        steps.append(("import again", [engine, "--headless", "--path", GAME_DIR, "--import"]))
    preflight = []
    if (GAME_DIR / "addons" / "godotsteam" / "godotsteam.gdextension").is_file():
        preflight.append("addons/godotsteam conflicts with the engine's built-in Steam module; remove the addon")
    autoloads = project_autoloads()
    checker_scene = None
    if autoloads:
        checker_scene = write_script_checker()
        print(f"check: {len(autoloads)} autoloads, scripts load in a scene", flush=True)
        steps.append(("scripts", [engine, "--headless", "--path", GAME_DIR, checker_scene]))
    else:
        for script in sorted(GAME_DIR.rglob("*.gd")):
            relative = script.relative_to(GAME_DIR)
            if any(part.startswith(".") for part in relative.parts):
                continue
            steps.append(
                (
                    f"script {relative.as_posix()}",
                    [
                        engine,
                        "--headless",
                        "--path",
                        GAME_DIR,
                        "--check-only",
                        "--script",
                        "res://" + relative.as_posix(),
                    ],
                )
            )
    steps.append(
        (
            "run",
            [engine, "--headless", "--path", GAME_DIR, "--quit-after", str(args.frames)],
        )
    )
    for scene in args.scene:
        steps.append(
            (
                f"scene {scene}",
                [engine, "--headless", "--path", GAME_DIR, "--quit-after", str(args.frames), scene],
            )
        )
    if not args.no_tests and (GAME_DIR / "tests" / "run_tests.gd").is_file():
        steps.append(
            (
                "tests",
                [
                    engine,
                    "--headless",
                    "--path",
                    GAME_DIR,
                    "--script",
                    "res://tests/run_tests.gd",
                    "--",
                    "--dir=res://tests",
                ],
            )
        )

    output = []
    failures = list(preflight)
    timed_out = False
    try:
        for step in steps:
            name, argv = step[0], step[1]
            collect = step[2] if len(step) > 2 else True
            try:
                result = run(
                    argv,
                    text=True,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    timeout=args.timeout,
                )
                text = result.stdout or ""
                output.append(("[ignored first import]\n" if not collect else "") + text)
                errors = collect_errors(text) if collect else []
                # The headless editor can abort at shutdown after the import. The run step still checks the assets.
                shutdown_crash = (
                    name == "import"
                    and result.returncode != 0
                    and bool(errors)
                    and all('singleton" is null' in error for error in errors)
                )
                if result.returncode != 0 and not shutdown_crash and collect:
                    if name == "tests":
                        failures.append("tests: failed")
                    else:
                        failures.append(f"{name}: engine exited with code {result.returncode}")
                for error in errors:
                    if shutdown_crash and 'singleton" is null' in error:
                        continue
                    failures.append(error)
            except subprocess.TimeoutExpired as exc:
                partial = exc.output or ""
                if isinstance(partial, bytes):
                    partial = partial.decode("utf-8", errors="replace")
                output.append(partial)
                failures.append(f"{name}: timed out after {args.timeout}s")
                timed_out = True
                break
    finally:
        if checker_scene is not None:
            remove_script_checker()

    log_path.write_text("".join(output), encoding="utf-8")
    test_summary = parse_test_result("".join(output))
    if test_summary is not None:
        write_test_junit(test_summary, junit_path)
        failures.extend(test_failure_lines(test_summary))
    failures = list(dict.fromkeys(failures))
    version = engine_version(engine) or "unknown"

    if failures:
        print(f"check: failed ({version})")
        for line in failures[:12]:
            print(f"  {line}")
        if len(failures) > 12:
            print(f"  ... and {len(failures) - 12} more")
        print(f"full log: {show_path(log_path)}")
        return 1

    main_scene = read_main_scene()
    print(f"check: ok ({version})")
    print(f"main scene: {main_scene}")
    if test_summary is not None:
        print(
            "tests: %d passed, %d failed, %d pending"
            % (
                int(test_summary.get("passed", 0)),
                int(test_summary.get("failed", 0)),
                int(test_summary.get("pending", 0)),
            )
        )
        print(f"junit: {show_path(junit_path)}")
    print(f"log: {show_path(log_path)}")
    return 0


def read_main_scene() -> str:
    project = GAME_DIR / "project.godot"
    try:
        text = project.read_text(encoding="utf-8")
    except OSError:
        return "unknown"
    match = re.search(r'^run/main_scene="([^"]+)"', text, re.MULTILINE)
    return match.group(1) if match else "not set"


def agent_state():
    try:
        return json.loads(AGENT_STATE.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return None
    except json.JSONDecodeError:
        die(f"`{show_path(AGENT_STATE)}` is not valid JSON")


def agent_pid_alive(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def agent_call(state: dict, method: str, params=None, timeout: float = 5.0):
    request = {
        "jsonrpc": "2.0",
        "id": 1,
        "method": method,
        "params": params or {},
        "token": state["token"],
    }
    with socket.create_connection(("127.0.0.1", int(state["port"])), timeout=timeout) as sock:
        sock.settimeout(timeout)
        sock.sendall((json.dumps(request) + "\n").encode("utf-8"))
        data = b""
        while b"\n" not in data:
            chunk = sock.recv(65536)
            if not chunk:
                break
            data += chunk
    if not data:
        raise OSError("the agent closed the connection")
    response = json.loads(data.split(b"\n", 1)[0].decode("utf-8"))
    if "error" in response:
        raise RuntimeError(response["error"].get("message", "agent error"))
    return response.get("result")


def agent_result(method: str, params=None):
    state = agent_state()
    if state is None:
        die("no agent is running. Run `bin/gai agent start` first.")
    if not agent_pid_alive(int(state.get("pid", 0))):
        die("the agent process is not running. Run `bin/gai agent start` again.")
    try:
        result = agent_call(state, method, params)
    except (OSError, RuntimeError, ValueError) as exc:
        die(f"agent: {exc}")
    return result


@contextmanager
def agent_lock():
    AGENT_LOCK.parent.mkdir(parents=True, exist_ok=True)
    try:
        import fcntl
    except ImportError:
        yield
        return
    with AGENT_LOCK.open("w") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(handle, fcntl.LOCK_UN)


def agent_starttime(pid: int):
    try:
        stat = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8")
    except OSError:
        return None
    try:
        rest = stat.rsplit(")", 1)[1].split()
        return rest[19]
    except (IndexError, ValueError):
        return None


def agent_pid_matches(pid: int, engine, starttime):
    current = agent_starttime(pid)
    if current is None:
        return None
    if starttime is None or str(starttime) != str(current):
        return False
    if engine:
        try:
            cmdline = Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode(
                "utf-8", errors="replace"
            )
        except OSError:
            return False
        if str(engine) not in cmdline:
            return False
    return True


def agent_terminate(state) -> bool:
    pid = int(state.get("pid", 0))
    if not agent_pid_alive(pid):
        return False
    verified = agent_pid_matches(pid, state.get("engine", ""), state.get("starttime"))
    if verified is None:
        try:
            agent_call(state, "ping", timeout=1)
            verified = True
        except (OSError, RuntimeError, ValueError):
            verified = False
    if not verified:
        return False
    try:
        os.kill(pid, signal.SIGTERM)
    except OSError:
        return False
    deadline = time.time() + 5
    while time.time() < deadline and agent_pid_alive(pid):
        time.sleep(0.1)
    if agent_pid_alive(pid):
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass
    return True


def write_agent_state(state: dict) -> None:
    tmp = AGENT_STATE.with_suffix(".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(json.dumps(state, indent=2) + "\n")
    os.replace(tmp, AGENT_STATE)


def _cmd_agent_start(args) -> int:
    existing = agent_state()
    if existing is not None:
        pid = int(existing.get("pid", 0))
        if agent_pid_alive(pid):
            try:
                agent_call(existing, "ping", timeout=1)
                print(f"agent already running on 127.0.0.1:{existing['port']}")
                return 0
            except (OSError, RuntimeError, ValueError):
                pass
            if agent_terminate(existing):
                print("agent: stopped an unresponsive old process")
        AGENT_STATE.unlink(missing_ok=True)

    engine = require_engine()
    require_game()
    if BIN_DIR in engine.parents:
        die(
            "the downloaded engine does not include the agent bridge. "
            "Build the engine (`docs/gai/build.md`), or set `GAI_GODOT` to a built binary."
        )

    probe = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        probe.bind(("127.0.0.1", 0))
        port = probe.getsockname()[1]
    finally:
        probe.close()

    token = secrets.token_hex(24)
    state = {
        "pid": 0,
        "port": port,
        "token": token,
        "engine": str(engine),
        "log": str(AGENT_LOG),
    }
    env = os.environ.copy()
    env["GAI_AGENT_PORT"] = str(port)
    env["GAI_AGENT_TOKEN"] = token
    if args.editor:
        env["GAI_AGENT_EDITOR"] = "1"
    AGENT_LOG.write_text("", encoding="utf-8")
    with AGENT_LOG.open("wb") as log:
        command = [str(engine)]
        if not args.display:
            command.append("--headless")
        command += ["--path", str(GAME_DIR)]
        if args.editor:
            command.append("--editor")
        process = subprocess.Popen(
            command,
            cwd=str(GAME_DIR),
            env=env,
            stdin=subprocess.DEVNULL,
            stdout=log,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
    state["pid"] = process.pid
    state["starttime"] = agent_starttime(process.pid)
    write_agent_state(state)

    deadline = time.time() + 20
    while time.time() < deadline:
        if process.poll() is not None:
            tail = "\n".join(
                AGENT_LOG.read_text(encoding="utf-8", errors="replace").splitlines()[-12:]
            )
            AGENT_STATE.unlink(missing_ok=True)
            die(f"the agent exited before it was ready.\n{tail}")
        try:
            result = agent_call(state, "ping", timeout=1)
            print(f"agent ready on 127.0.0.1:{port} ({result.get('engine', 'unknown')})")
            return 0
        except (OSError, RuntimeError, ValueError):
            time.sleep(0.25)

    process.terminate()
    try:
        process.wait(timeout=5)
    except subprocess.TimeoutExpired:
        process.kill()
    AGENT_STATE.unlink(missing_ok=True)
    tail = "\n".join(
        AGENT_LOG.read_text(encoding="utf-8", errors="replace").splitlines()[-12:]
    )
    die(f"the agent did not answer within 20s.\n{tail}")


def _cmd_agent_stop(args) -> int:
    state = agent_state()
    if state is None:
        print("agent is not running")
        return 0
    pid = int(state.get("pid", 0))
    if agent_pid_alive(pid):
        if agent_terminate(state):
            print("agent stopped")
        else:
            print(f"agent: pid {pid} is not the agent; removing stale state")
    else:
        print("agent stopped")
    AGENT_STATE.unlink(missing_ok=True)
    return 0


def cmd_agent_start(args) -> int:
    with agent_lock():
        return _cmd_agent_start(args)


def cmd_agent_stop(args) -> int:
    with agent_lock():
        return _cmd_agent_stop(args)


def cmd_agent_status(args) -> int:
    state = agent_state()
    if state is None:
        print("agent: not running")
        return 1
    if not agent_pid_alive(int(state.get("pid", 0))):
        print("agent: stale state; run `bin/gai agent stop`")
        return 1
    try:
        result = agent_call(state, "ping", timeout=2)
    except (OSError, RuntimeError, ValueError) as exc:
        print(f"agent: process alive but not responding ({exc})")
        return 1
    print(f"agent: running on 127.0.0.1:{state['port']} ({result.get('engine', 'unknown')})")
    return 0


def cmd_agent_tree(args) -> int:
    print(json.dumps(agent_result("scene.tree"), indent=2, ensure_ascii=False))
    return 0


def cmd_agent_get(args) -> int:
    params = {"path": args.path}
    if args.property:
        params["properties"] = args.property
    print(json.dumps(agent_result("node.get", params), indent=2, ensure_ascii=False))
    return 0


def cmd_agent_set(args) -> int:
    try:
        value = json.loads(args.value)
    except json.JSONDecodeError:
        value = args.value
    result = agent_result(
        "node.set",
        {"path": args.path, "property": args.property, "value": value},
    )
    print(json.dumps(result, indent=2, ensure_ascii=False))
    return 0


def cmd_agent_call(args) -> int:
    try:
        params = json.loads(args.params)
    except json.JSONDecodeError as exc:
        die(f"params must be JSON: {exc}")
    print(json.dumps(agent_result(args.method, params), indent=2, ensure_ascii=False))
    return 0


def cmd_agent_methods(args) -> int:
    print(json.dumps(agent_result("api.methods"), indent=2, ensure_ascii=False))
    return 0


def cmd_agent_watch(args) -> int:
    state = agent_state()
    if state is None:
        die("no agent is running. Run `bin/gai agent start` first.")
    if not agent_pid_alive(int(state.get("pid", 0))):
        die("the agent process is not running. Run `bin/gai agent start` again.")
    params = {"signal": args.signal}
    if args.handle:
        params["handle"] = args.handle
    else:
        params["path"] = args.path
    try:
        sock = socket.create_connection(("127.0.0.1", int(state["port"])), timeout=5)
    except OSError as exc:
        die(f"agent: {exc}")
    sock.settimeout(None)
    stream = sock.makefile("r", encoding="utf-8", newline="\n")
    request = {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "event.subscribe",
        "params": params,
        "token": state["token"],
    }
    try:
        sock.sendall((json.dumps(request) + "\n").encode("utf-8"))
        line = stream.readline()
        if not line:
            print("agent: the bridge closed the connection", file=sys.stderr)
            return 1
        response = json.loads(line)
    except (OSError, ValueError) as exc:
        print(f"agent: {exc}", file=sys.stderr)
        return 1
    if "error" in response:
        print(f"agent: {response['error'].get('message', 'subscribe failed')}", file=sys.stderr)
        return 1
    result = response.get("result", {})
    subscription = result.get("subscription")
    print(
        f"watching {args.path or args.handle} {args.signal} (subscription {subscription})",
        file=sys.stderr,
        flush=True,
    )
    seen = 0
    try:
        for line in stream:
            text = line.strip()
            if not text:
                continue
            try:
                message = json.loads(text)
            except ValueError:
                continue
            if message.get("method") != "event":
                continue
            print(json.dumps(message, ensure_ascii=False), flush=True)
            seen += 1
            if message.get("params", {}).get("closed"):
                break
            if args.count > 0 and seen >= args.count:
                break
    except KeyboardInterrupt:
        pass
    finally:
        try:
            unsubscribe = {
                "jsonrpc": "2.0",
                "id": 2,
                "method": "event.unsubscribe",
                "params": {"subscription": subscription},
                "token": state["token"],
            }
            sock.sendall((json.dumps(unsubscribe) + "\n").encode("utf-8"))
        except OSError:
            pass
        try:
            stream.close()
        except OSError:
            pass
        try:
            sock.close()
        except OSError:
            pass
    return 0


def cmd_agent_log(args) -> int:
    try:
        lines = AGENT_LOG.read_text(encoding="utf-8", errors="replace").splitlines()
    except FileNotFoundError:
        die("no agent log yet. Run `bin/gai agent start` first.")
    for line in lines[-args.lines:]:
        print(line)
    return 0


def cmd_mcp(args) -> int:
    require_game()
    sys.path.insert(0, str(Path(__file__).resolve().parent))
    try:
        import gai_mcp
    except ImportError as error:
        print(f"gai-mcp: cannot import gai_mcp: {error}", file=sys.stderr)
        return 1
    if args.start:
        with contextlib.redirect_stdout(sys.stderr):
            code = cmd_agent_start(argparse.Namespace(display=args.display, editor=args.editor))
        if code != 0:
            return code
    state = agent_state()
    if state is None:
        print(
            "gai-mcp: no agent is running. Run `bin/gai agent start`, or pass --start.",
            file=sys.stderr,
        )
        return 1
    if not agent_pid_alive(int(state.get("pid", 0))):
        print(
            "gai-mcp: the agent process is not running. Run `bin/gai agent stop`, then start it again.",
            file=sys.stderr,
        )
        return 1

    try:
        connection = gai_mcp.BridgeConnection(
            state["port"], state["token"], timeout=args.timeout
        )
    except (OSError, ValueError) as exc:
        print(f"gai-mcp: cannot connect to the bridge: {exc}", file=sys.stderr)
        return 1

    def bridge(method: str, params: dict):
        return connection.call(method, params)

    gai_bin = Path(__file__).resolve()

    def runner(command, timeout):
        try:
            result = subprocess.run(
                [sys.executable, str(gai_bin), *command],
                cwd=str(ROOT),
                env=os.environ.copy(),
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                timeout=timeout,
            )
            return {
                "returncode": result.returncode,
                "stdout": result.stdout or "",
                "stderr": result.stderr or "",
            }
        except subprocess.TimeoutExpired as exc:
            partial = exc.output or ""
            if isinstance(partial, bytes):
                partial = partial.decode("utf-8", errors="replace")
            return {
                "returncode": -1,
                "stdout": partial,
                "stderr": "",
                "error": f"timed out after {timeout}s",
            }

    version = "unknown"
    try:
        version = (GAI_DIR / "version").read_text(encoding="utf-8").strip() or "unknown"
    except OSError:
        pass

    try:
        return gai_mcp.serve(
            bridge,
            sys.stdin,
            sys.stdout,
            root=ROOT,
            project=GAME_DIR,
            runtime=RUNTIME_DIR,
            version=version,
            runner=runner,
            command_timeout=args.command_timeout,
            event_source=connection,
        )
    finally:
        connection.close()


def cmd_run(args) -> int:
    engine = require_engine()
    require_game()
    extra = list(args.extra)
    if extra[:1] == ["--"]:
        extra = extra[1:]
    argv = [engine, "--path", GAME_DIR, *extra]
    print(f"running {engine_version(engine) or engine}", flush=True)
    try:
        return run(argv).returncode
    except KeyboardInterrupt:
        return 130


def cmd_editor(args) -> int:
    engine = require_engine()
    require_game()
    if platform.system() == "Linux" and not (
        os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")
    ):
        print("gai: no display found. The editor needs a desktop session.", file=sys.stderr)
        return 1
    try:
        return run([engine, "--path", GAME_DIR, "--editor"]).returncode
    except KeyboardInterrupt:
        return 130


def load_features():
    features = []
    for path in sorted(FEATURES_DIR.glob("*.json")):
        try:
            feature = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as exc:
            die(f"`{path.relative_to(ROOT)}` is not valid JSON: {exc}")
        feature["id"] = path.stem
        if feature.get("status") not in ("active", "planned"):
            die(f"`{path.relative_to(ROOT)}` has an unknown status")
        features.append(feature)
    return features


def feature_for_path(path: str, features):
    for feature in features:
        if feature.get("status") != "active":
            continue
        for claim in feature.get("paths", []):
            if claim.endswith("/"):
                if path.startswith(claim):
                    return feature["id"]
            elif path == claim:
                return feature["id"]
    return None


def path_allowed(path: str, features) -> bool:
    if path in WORKSPACE_FILES:
        return True
    if any(path.startswith(prefix) for prefix in WORKSPACE_PREFIXES):
        return True
    return feature_for_path(path, features) is not None


def unclaimed_changes(base: str, staged: bool = False, features=None):
    args = ["diff", "--name-status", "--no-renames", base]
    if staged:
        args.insert(1, "--cached")
    result = git(*args)
    if features is None:
        features = load_features()
    unclaimed = []
    for line in result.stdout.splitlines():
        if not line.strip():
            continue
        parts = line.split("\t")
        status, path = parts[0], parts[-1]
        if not path_allowed(path, features):
            unclaimed.append((status, path))
    return unclaimed


def check_base(state: dict) -> None:
    commit = state["commit"]
    if git("cat-file", "-e", f"{commit}^{{commit}}", check=False).returncode != 0:
        die(
            f"upstream base {commit[:8]} is not in this clone. "
            "A shallow clone cannot verify the fork. Run `git fetch --unshallow`."
        )
    if git("merge-base", "--is-ancestor", commit, "HEAD", check=False).returncode != 0:
        die(f"upstream base {commit[:8]} is not an ancestor of HEAD")


def missing_required(state: dict, staged: bool = False):
    missing = []
    for path in state.get("required", []):
        ref = f":{path}" if staged else f"HEAD:{path}"
        if git("cat-file", "-e", ref, check=False).returncode != 0:
            missing.append(path)
    return missing


def untracked_paths():
    result = git("ls-files", "--others", "--exclude-standard")
    return [line for line in result.stdout.splitlines() if line.strip()]


def untracked_violations():
    features = load_features()
    return [
        ("??", path) for path in untracked_paths() if not path_allowed(path, features)
    ]


def print_missing(missing) -> None:
    print("fork: required files are missing")
    for path in missing:
        print(f"  {path}")
    print("Restore the file, or remove it from `required` in `.gai/upstream.json`.")


def print_unclaimed(unclaimed) -> None:
    print("fork: unclaimed engine changes")
    for status, path in unclaimed:
        print(f"  {status} {path}")
    print('Claim each path in `.gai/features/<name>.json` with `"status": "active"`, or move it to a workspace path.')


def cmd_upstream_status(args) -> int:
    state = load_upstream()
    merge = git("rev-parse", "--verify", "-q", "MERGE_HEAD", check=False)
    count = git("rev-list", "--count", f"{state['commit']}..HEAD", check=False)
    ahead = count.stdout.strip() if count.returncode == 0 else "unknown"
    print(f"gai {gai_version()}")
    print(f"base {state['tag']} {state['commit'][:8]} ({state.get('merged_at', 'unknown')})")
    features = load_features()
    active = sum(1 for feature in features if feature.get("status") == "active")
    print(f"features: {len(features)} ({active} active)")
    print(f"commits since base: {ahead}")
    if merge.returncode == 0:
        print("merge in progress: yes")
    else:
        print("merge in progress: no")
    return 0


def cmd_upstream_check(args) -> int:
    state = load_upstream()
    check_base(state)
    features = load_features()
    missing = missing_required(state)
    if missing:
        print_missing(missing)
        return 1
    unclaimed = unclaimed_changes(state["commit"], features=features)
    untracked = untracked_violations()
    strict = getattr(args, "strict", False)

    if strict and (unclaimed or untracked):
        if unclaimed:
            print_unclaimed(unclaimed)
        if untracked:
            print("fork: untracked files with no owner")
            for _, path in untracked:
                print(f"  {path}")
        return 1

    if unclaimed:
        print("warning: engine changes with no feature owner")
        for status, path in unclaimed:
            print(f"  {status} {path}")
        print("Run `bin/gai upstream report` for the merge risk. Add a feature only if gai should maintain the change.")
    if untracked:
        print("warning: untracked files with no owner")
        for _, path in untracked:
            print(f"  {path}")

    changed = git("diff", "--name-only", state["commit"], "HEAD").stdout.splitlines()
    active = sum(1 for feature in features if feature.get("status") == "active")
    warns = len(unclaimed) + len(untracked)
    suffix = f"; {warns} warnings" if warns else ""
    print(f"base {state['tag']} {state['commit'][:8]}")
    print(f"features: {len(features)} ({active} active)")
    print(f"fork: ok ({len(changed)} files since base{suffix})")
    return 0


def cmd_upstream_report(args) -> int:
    state = load_upstream()
    check_base(state)
    features = load_features()
    changed = git("diff", "--name-status", "--no-renames", state["commit"]).stdout.splitlines()
    counts = {}
    unclaimed = []

    print(f"base {state['tag']} {state['commit'][:8]}")
    print("features:")
    for feature in features:
        print(
            f"  {feature['id']} {feature.get('status', '?')} "
            f"risk={feature.get('risk', '?')} {feature.get('title', '')}"
        )

    print("changes:")
    for line in changed:
        if not line.strip():
            continue
        parts = line.split("\t")
        status, path = parts[0], parts[-1]
        owner = feature_for_path(path, features)
        if owner is None and path_allowed(path, features):
            owner = "workspace"
        print(f"  {status} {path} ({owner or 'unclaimed'})")
        if owner is None:
            unclaimed.append((status, path))
        else:
            counts[owner] = counts.get(owner, 0) + 1

    for path in untracked_paths():
        owner = feature_for_path(path, features)
        if owner is None and path_allowed(path, features):
            owner = "workspace"
        print(f"  ?? {path} ({owner or 'unclaimed'})")
        if owner is None:
            unclaimed.append(("??", path))
        else:
            counts[owner] = counts.get(owner, 0) + 1

    print("summary:")
    for owner in sorted(counts):
        print(f"  {owner}: {counts[owner]}")
    print(f"unclaimed: {len(unclaimed)}")
    if unclaimed:
        print('Claim each unclaimed path in `.gai/features/<name>.json` with `"status": "active"`.')
    return 0


def ensure_upstream_remote() -> None:
    existing = git("remote", "get-url", "upstream", check=False)
    if existing.returncode == 0:
        return
    git("remote", "add", "upstream", DEFAULT_UPSTREAM)
    print(f"added remote upstream {DEFAULT_UPSTREAM}")


def merge_in_progress() -> bool:
    return git("rev-parse", "--verify", "-q", "MERGE_HEAD", check=False).returncode == 0


def unmerged_files():
    result = git("diff", "--name-only", "--diff-filter=U")
    return [line for line in result.stdout.splitlines() if line.strip()]


BRAND_KEYS = ("name", "website")


def read_brand(text: str):
    values = {}
    for key in BRAND_KEYS:
        match = re.search(rf'^{key} = "([^"]*)"$', text, re.MULTILINE)
        if not match:
            return None
        values[key] = match.group(1)
    return values


def resolve_version_conflict() -> bool:
    if "version.py" not in unmerged_files():
        return False
    ours = git("show", "HEAD:version.py", check=False)
    theirs = git("show", "MERGE_HEAD:version.py", check=False)
    if ours.returncode != 0 or theirs.returncode != 0:
        return False
    brand = read_brand(ours.stdout)
    if brand is None:
        return False

    text = theirs.stdout
    for key, value in brand.items():
        if not re.search(rf'^{key} = ".*"$', text, re.MULTILINE):
            return False
        text = re.sub(rf'^{key} = ".*"$', f'{key} = "{value}"', text, count=1, flags=re.MULTILINE)

    (ROOT / "version.py").write_text(text, encoding="utf-8")
    git("add", "version.py")
    print("resolved version.py: kept name and website, took upstream's version numbers", flush=True)
    return True


def print_conflict_help(paths) -> None:
    features = load_features()
    print("merge conflicts:")
    for path in paths:
        owner = feature_for_path(path, features)
        if owner is None and path_allowed(path, features):
            owner = "workspace"
        print(f"  {path} ({owner or 'unclaimed'})")
    print("Resolve each file, then run: bin/gai upstream continue")


def tag_for_commit(commit: str) -> str:
    tags = [tag for tag in git("tag", "--points-at", commit).stdout.splitlines() if tag]
    stable = [tag for tag in tags if tag.endswith("-stable")]
    if stable:
        return sorted(stable)[-1]
    return sorted(tags)[-1] if tags else f"upstream@{commit[:8]}"


def finalize_merge(commit: str, strict: bool = False) -> int:
    state = load_upstream()
    features = load_features()
    unclaimed = unclaimed_changes(commit, staged=True, features=features)
    if unclaimed and strict:
        print_unclaimed(unclaimed)
        return 1
    if unclaimed:
        print("warning: engine changes with no feature owner")
        for status, path in unclaimed:
            print(f"  {status} {path}")
        print("The merge will continue. Add a feature only if gai should maintain these changes.")
    missing = missing_required(state, staged=True)
    if missing:
        print_missing(missing)
        return 1

    state["commit"] = commit
    state["tag"] = tag_for_commit(commit)
    state["merged_at"] = date.today().isoformat()
    save_upstream(state)
    git("add", ".gai/upstream.json")
    git("commit", "-m", f"Merge upstream {state['tag']}")
    print(f"merged {state['tag']} ({commit[:8]})")
    print(f"base {state['tag']} {commit[:8]}")
    print("next: rebuild the engine (docs/gai/build.md)")
    print("then: bin/gai engine install --force && bin/gai check")
    return 0


def cmd_upstream_merge(args) -> int:
    if merge_in_progress():
        die("a merge is in progress. Resolve it, then run `bin/gai upstream continue`.")
    dirty = git("status", "--porcelain", "--untracked-files=no").stdout.strip()
    if dirty:
        die("the working tree has uncommitted changes to tracked files. Commit or stash them first.")
    state = load_upstream()
    check_base(state)
    ensure_upstream_remote()
    print("fetching upstream tags")
    git("fetch", "--tags", "upstream")
    resolved = git("rev-parse", "--verify", "-q", f"{args.ref}^{{commit}}", check=False)
    if resolved.returncode != 0:
        die(f"cannot resolve `{args.ref}` after fetch")

    commit = resolved.stdout.strip()
    if git("merge-base", "--is-ancestor", commit, "HEAD", check=False).returncode == 0:
        if commit == state["commit"]:
            print(f"already at {state['tag']} ({commit[:8]})")
            return 0
        die(f"`{args.ref}` is already in history but is not the recorded base. Nothing to merge.")

    result = git("merge", "--no-commit", "--no-ff", commit, check=False)
    if result.returncode != 0:
        conflicts = unmerged_files()
        if "version.py" in conflicts and resolve_version_conflict():
            conflicts = unmerged_files()
            if not conflicts:
                return finalize_merge(commit, getattr(args, "strict", False))
        if conflicts:
            print_conflict_help(conflicts)
            return 1
        detail = (result.stderr or result.stdout).strip()
        die(f"merge failed: {detail}")

    if not merge_in_progress():
        die("merge produced no changes")
    return finalize_merge(commit, getattr(args, "strict", False))


def cmd_upstream_continue(args) -> int:
    if not merge_in_progress():
        die("no merge in progress")
    resolve_version_conflict()
    conflicts = unmerged_files()
    if conflicts:
        print_conflict_help(conflicts)
        return 1
    merge_head = git("rev-parse", "MERGE_HEAD").stdout.strip()
    return finalize_merge(merge_head, getattr(args, "strict", False))


def cmd_upstream_abort(args) -> int:
    if not merge_in_progress():
        die("no merge in progress")
    git("checkout", "HEAD", "--", ".gai/upstream.json", check=False)
    git("merge", "--abort")
    print("merge aborted")
    return 0


def export_templates_dir() -> Path:
    if platform.system() == "Darwin":
        base = Path.home() / "Library" / "Application Support" / "Godot"
    elif platform.system() == "Windows":
        base = Path(os.environ.get("APPDATA", str(Path.home() / "AppData" / "Roaming"))) / "Godot"
    else:
        base = Path.home() / ".local" / "share" / "godot"
    return base / "export_templates"


def engine_template_version(engine) -> str:
    version = engine_version(engine) or "unknown"
    return version.split(".custom_build", 1)[0]


def project_name() -> str:
    project = GAME_DIR / "project.godot"
    try:
        text = project.read_text(encoding="utf-8")
    except OSError:
        return "game"
    match = re.search(r'^config/name="([^"]+)"', text, re.MULTILINE)
    name = match.group(1) if match else "game"
    name = re.sub(r"[^A-Za-z0-9._-]+", "-", name).strip("-")
    return name or "game"


def export_presets() -> dict:
    path = GAME_DIR / "export_presets.cfg"
    if not path.is_file():
        return {}
    sections: dict[str, dict[str, str]] = {}
    current = ""
    for line in path.read_text(encoding="utf-8").splitlines():
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            current = stripped[1:-1]
            sections.setdefault(current, {})
            continue
        if not current or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip()
        if len(value) >= 2 and value[0] == '"' and value[-1] == '"':
            value = value[1:-1]
        sections[current].setdefault(key, value)
    presets = {}
    for section, values in sections.items():
        if not section.startswith("preset.") or section.endswith(".options"):
            continue
        name = values.get("name", "")
        if not name:
            continue
        options = sections.get(f"{section}.options", {})
        presets[name] = {
            "template": options.get("custom_template/release", ""),
            "export_path": values.get("export_path", ""),
            "options": f"{section}.options",
        }
    return presets


def steam_runtime_for(target: str):
    if target == "windows":
        folder, name = "win64", "steam_api64.dll"
    elif target == "linux":
        folder, name = "linux64", "libsteam_api.so"
    elif target == "macos":
        folder, name = "osx", "libsteam_api.dylib"
    else:
        return None
    path = STEAM_SDK / "redistributable_bin" / folder / name
    return path if path.is_file() else None


def write_sha256sums(paths, destination: Path) -> Path:
    lines = []
    for path in sorted(paths):
        digest = hashlib.sha256()
        with path.open("rb") as handle:
            for chunk in iter(lambda: handle.read(1024 * 1024), b""):
                digest.update(chunk)
        lines.append(f"{digest.hexdigest()}  {path.name}")
    destination.write_text("\n".join(lines) + "\n", encoding="utf-8")
    return destination


def make_archive(paths, archive: Path) -> Path:
    archive = archive.expanduser()
    suffix = archive.name.lower()
    if suffix.endswith(".zip"):
        with zipfile.ZipFile(archive, "w", zipfile.ZIP_DEFLATED) as bundle:
            for path in paths:
                bundle.write(path, path.name)
        return archive
    if suffix.endswith(".tar.gz") or suffix.endswith(".tgz"):
        with tarfile.open(archive, "w:gz") as bundle:
            for path in paths:
                bundle.add(path, arcname=path.name)
        return archive
    raise ValueError("archive must end with .zip, .tar.gz, or .tgz")


def init_write(path: Path, content: str, force: bool) -> bool:
    if path.exists() and not force:
        print(f"init: keep {path}")
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")
    print(f"init: wrote {path}")
    return True


def init_agents_text(target: Path, scene_tests: bool) -> str:
    gai = (ROOT / "bin" / "gai").resolve()
    test_command = (
        f"GAI_GAME={target} {gai} test --scene-dir res://tests"
        if scene_tests
        else f"GAI_GAME={target} {gai} test"
    )
    return f"""# {target.name} agent guide

This project is a Godot game. Use gai to check it, test it, run it, and inspect
a live scene.

## Commands

```sh
GAI_GAME={target} {gai} check
{test_command}
GAI_GAME={target} {gai} run -- --headless --quit-after 60
GAI_GAME={target} {gai} editor
```

Live scene:

```sh
GAI_GAME={target} {gai} agent start
GAI_GAME={target} {gai} agent tree
GAI_GAME={target} {gai} agent call api.autoloads '{{}}'
GAI_GAME={target} {gai} agent stop
```

MCP: `.gai/mcp.json` starts `{gai} mcp --start` for this project.

## Rules

- Read `project.godot` before changing scenes or input actions.
- Keep `res://` paths in the project. Do not use absolute paths in game files.
- Run `bin/gai check` after every scene or script change.
- Add a test in `tests/` when behavior is not visible from a run.
- Do not edit `.godot/`; it is an import cache.
- Do not claim that a scene looks right. Say what the check proves.

## Tests

{"This project uses scene tests: `bin/gai test --scene-dir res://tests`." if scene_tests else "The harness lives in `tests/run_tests.gd`. A test extends `res://tests/gai_test_case.gd`."}

See `{ROOT / "docs" / "gai" / "testing.md"}` for the harness and scene mode.
"""


def cmd_init(args) -> int:
    target = Path(args.path).expanduser().resolve() if args.path else GAME_DIR.resolve()
    if not (target / "project.godot").is_file():
        print(f"gai: {target} is not a Godot project (project.godot is missing)", file=sys.stderr)
        return 1
    tests = target / "tests"
    existing_tests = any(
        path.suffix in (".gd", ".tscn") for path in tests.rglob("*") if path.is_file()
    ) if tests.is_dir() else False
    scene_tests = existing_tests and not (tests / "run_tests.gd").is_file()

    init_write(target / "AGENTS.md", init_agents_text(target, scene_tests), args.force)
    init_write(
        target / "docs" / "gai.md",
        f"# gai\n\nThis project uses gai from `{ROOT}`.\n\n"
        "Run `bin/gai check` for the game gate. Read "
        f"`{ROOT / 'docs' / 'gai' / 'testing.md'}` for tests.\n",
        args.force,
    )

    if scene_tests:
        print("init: existing scene tests found; the GDScript harness is not installed")
    else:
        for name in ("gai_test_case.gd", "run_tests.gd"):
            source = ROOT / "game" / "tests" / name
            if source.is_file():
                init_write(tests / name, source.read_text(encoding="utf-8"), args.force)
        if not (tests / "test_project.gd").is_file():
            init_write(
                tests / "test_project.gd",
                r'''extends "res://tests/gai_test_case.gd"


func test_project_has_main_scene() -> void:
	var path := String(ProjectSettings.get_setting("application/run/main_scene", ""))
	assert_true(not path.is_empty(), "a main scene is set")
	if path.is_empty():
		return
	var packed := load(path) as PackedScene
	assert_not_null(packed, "the main scene loads")
''',
                args.force,
            )

    if not args.no_mcp:
        mcp = {
            "mcpServers": {
                "gai": {
                    "command": str((ROOT / "bin" / "gai").resolve()),
                    "args": ["mcp", "--start"],
                    "env": {"GAI_GAME": str(target)},
                }
            }
        }
        init_write(target / ".gai" / "mcp.json", json.dumps(mcp, indent=2) + "\n", args.force)

    print("init: next: GAI_GAME=%s %s check" % (target, (ROOT / "bin" / "gai").resolve()))
    return 0


def cmd_export_native(args) -> int:
    engine = require_engine()
    require_game()
    target = args.export_target
    presets = export_presets()
    preset_name = args.preset or args.default_preset
    if preset_name not in presets:
        print(f"gai: preset `{preset_name}` is not in export_presets.cfg")
        if presets:
            print("gai: presets: " + ", ".join(sorted(presets)))
        return 1
    preset = presets[preset_name]

    template = preset.get("template", "")
    if template:
        template_path = Path(template).expanduser()
        if not template_path.is_absolute():
            template_path = (GAME_DIR / template_path).resolve()
        if not template_path.is_file():
            print(f"gai: custom template is missing: {template_path}")
            print("gai: build it with `bin/gai build --target template_release --platform ...`.")
            return 1

    if args.output:
        output = Path(args.output).expanduser()
        if not output.is_absolute():
            output = GAME_DIR / output
    elif preset.get("export_path"):
        output = (GAME_DIR / preset["export_path"]).resolve()
    else:
        extension = ".exe" if target == "windows" else ".x86_64"
        output = GAME_DIR / "build" / target / (project_name() + extension)
    output = output.resolve()

    inside_game = output.parent != GAME_DIR and GAME_DIR in output.parents
    if args.clean and inside_game and output.parent.is_dir():
        shutil.rmtree(output.parent)
    output.parent.mkdir(parents=True, exist_ok=True)
    if inside_game:
        (output.parent / ".gdignore").touch()

    mode = "on" if args.steam_runtime else "off" if args.no_steam_runtime else "auto"
    library = steam_runtime_for(target)
    if mode == "on" and library is None:
        print(f"gai: no Steam runtime library for {target}")
        print("gai: run `bin/gai steam sdk --download` first.")
        return 1

    command = [engine, "--headless", "--path", GAME_DIR, "--export-release", preset_name, str(output)]
    if args.dry_run:
        print(" ".join(str(part) for part in command))
        print(f"output {output}")
        return 0
    print(f"gai: exporting {preset_name} to {output}", flush=True)
    try:
        result = run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=args.timeout,
        )
    except subprocess.TimeoutExpired:
        print(f"gai: export timed out after {args.timeout}s")
        return 1
    text = result.stdout or ""
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    log_path = LOG_DIR / "export.log"
    log_path.write_text(text, encoding="utf-8")
    if result.returncode != 0:
        for line in text.splitlines()[-16:]:
            print(line)
        print(f"gai: export failed; log {show_path(log_path)}")
        return 1
    if not output.is_file() or output.stat().st_size == 0:
        print(f"gai: export did not write {output}")
        return 1

    copied = []
    if mode != "off" and library is not None:
        destination = output.parent / library.name
        if destination != library:
            shutil.copy2(library, destination)
            copied.append(destination)
        print(f"gai: steam runtime {destination}")

    paths = [output]
    for sidecar in (output.with_suffix(".pck"), Path(str(output) + ".pck")):
        if sidecar.is_file() and sidecar not in paths:
            paths.append(sidecar)
    paths.extend(copied)
    if args.archive:
        archive = Path(args.archive).expanduser()
        if not archive.is_absolute():
            archive = output.parent / archive
        if archive.suffix == "":
            archive = archive.with_name(archive.name + (".zip" if target == "windows" else ".tar.gz"))
        try:
            archive.parent.mkdir(parents=True, exist_ok=True)
            make_archive(paths, archive)
        except (ValueError, OSError) as error:
            print(f"gai: cannot write archive: {error}")
            return 1
        paths.append(archive)
        print(f"gai: archive {archive}")

    if args.checksum:
        sums = write_sha256sums(paths, output.parent / "SHA256SUMS")
        print(f"gai: checksums {sums}")

    size = sum(path.stat().st_size for path in paths)
    print(f"gai: exported {output.name}, {size / (1024 * 1024):.1f} MiB")
    print(f"gai: log {show_path(log_path)}")
    return 0


def cmd_export_web(args) -> int:
    engine = require_engine()
    require_game()
    version = engine_template_version(engine)
    templates = export_templates_dir() / version
    if not any((templates / name).is_file() for name in ("web_nothreads_release.zip", "web_release.zip")):
        print(f"gai: no web export templates for {version} in {templates}")
        print("gai: download Godot's export templates, then extract templates/web_*.zip and templates/version.txt there.")
        return 1
    output = Path(args.output).expanduser()
    if not output.is_absolute():
        output = GAME_DIR / output
    inside_game = output.parent != GAME_DIR and GAME_DIR in output.parents
    if args.clean and inside_game and output.parent.is_dir():
        shutil.rmtree(output.parent)
    output.parent.mkdir(parents=True, exist_ok=True)
    if inside_game:
        (output.parent / ".gdignore").touch()
    command = [engine, "--headless", "--path", GAME_DIR, "--export-release", args.preset, str(output)]
    print(f"gai: exporting {args.preset} to {output}", flush=True)
    try:
        result = run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=args.timeout,
        )
    except subprocess.TimeoutExpired:
        print(f"gai: export timed out after {args.timeout}s")
        return 1
    text = result.stdout or ""
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    log_path = LOG_DIR / "export.log"
    log_path.write_text(text, encoding="utf-8")
    if result.returncode != 0:
        for line in text.splitlines()[-12:]:
            print(line)
        print(f"gai: export failed; log {show_path(log_path)}")
        return 1
    expected = [output, output.with_suffix(".wasm"), output.with_suffix(".pck")]
    missing = [str(path) for path in expected if not path.is_file()]
    if missing:
        for path in missing:
            print(f"gai: missing {path}")
        return 1
    if args.gzip:
        for suffix in (".html", ".js", ".wasm", ".pck"):
            source = output.with_suffix(suffix)
            if source.is_file():
                with source.open("rb") as src, gzip.open(str(source) + ".gz", "wb", compresslevel=9) as dst:
                    shutil.copyfileobj(src, dst)
    files = [path for path in output.parent.iterdir() if path.is_file()]
    size = sum(path.stat().st_size for path in files)
    print(f"gai: exported {len(files)} files, {size / (1024 * 1024):.0f} MiB")
    print(f"gai: log {show_path(log_path)}")
    return 0


def cmd_doctor(args) -> int:
    problems = []
    warnings = []
    print(f"gai {gai_version()}")
    print(f"repo {ROOT}")
    print(f"python {platform.python_version()}")

    state = load_upstream()
    print(f"upstream {state['tag']} {state['commit'][:8]}")
    features = load_features()
    active = sum(1 for feature in features if feature.get("status") == "active")
    print(f"features: {len(features)} ({active} active)")
    if git("cat-file", "-e", f"{state['commit']}^{{commit}}", check=False).returncode != 0:
        problems.append("upstream base is not in this clone (shallow clone?)")
    elif git("merge-base", "--is-ancestor", state["commit"], "HEAD", check=False).returncode != 0:
        problems.append("upstream base is not an ancestor of HEAD")
    else:
        unclaimed = unclaimed_changes(state["commit"])
        if unclaimed:
            warnings.append(f"{len(unclaimed)} unclaimed engine changes")
        untracked = untracked_violations()
        if untracked:
            warnings.append(f"{len(untracked)} untracked files with no owner")
        missing = missing_required(state)
        if missing:
            problems.append(f"{len(missing)} required files are missing")

    project = GAME_DIR / "project.godot"
    if project.is_file():
        print(f"game {GAME_DIR}")
        print(f"main scene {read_main_scene()}")
    else:
        problems.append(f"`{show_path(GAME_DIR / 'project.godot')}` is missing")

    if steam_sdk_ready():
        print(f"steam sdk {steam_sdk_version() or 'unknown'}")
    else:
        print("steam sdk missing (the engine builds without Steam)")

    engine = find_engine()
    if engine is None:
        problems.append(
            "no engine found; run `bin/gai bootstrap` to build it, or "
            "`bin/gai engine install` for the official fallback"
        )
    else:
        version = engine_version(engine) or "unknown"
        print(f"engine {version}")
        print(f"engine path {engine}")
        problems.extend(version_problems(engine, state))

    if problems:
        print(f"status: {len(problems)} problems, {len(warnings)} warnings")
        for problem in problems:
            print(f"  {problem}")
        for warning in warnings:
            print(f"  warning: {warning}")
        return 1
    if warnings:
        print(f"status: ok ({len(warnings)} warnings)")
        for warning in warnings:
            print(f"  warning: {warning}")
        return 0
    print("status: ok")
    return 0


def cmd_version(args) -> int:
    state = load_upstream()
    print(f"gai {gai_version()}")
    print(f"upstream {state['tag']} {state['commit'][:8]}")
    engine = find_engine()
    if engine is None:
        print("engine not installed")
    else:
        print(f"engine {engine_version(engine) or 'unknown'}")
        print(f"engine path {engine}")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="gai",
        description="Run the game, check it, and keep the engine close to upstream.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    version = sub.add_parser("version", help="show the gai, upstream, and engine versions")
    version.set_defaults(func=cmd_version)

    doctor = sub.add_parser("doctor", help="check the engine, the game, and the upstream base")
    doctor.set_defaults(func=cmd_doctor)

    bootstrap = sub.add_parser("bootstrap", help="build the engine if needed, then check the game")
    bootstrap.add_argument(
        "--official",
        action="store_true",
        help="use the official fallback engine instead of building gai",
    )
    bootstrap.add_argument(
        "--rebuild",
        action="store_true",
        help="rebuild the engine even when the binary is current",
    )
    bootstrap.set_defaults(func=cmd_bootstrap)

    build = sub.add_parser("build", help="build the gai engine from source")
    build.add_argument("--force", action="store_true", help="build even when the binary is current")
    build.add_argument("--check", action="store_true", help="exit 1 when a rebuild is needed")
    build.add_argument("--dry-run", action="store_true", help="print the build command")
    build.add_argument("--jobs", type=int, default=None, help="SCons jobs (default: memory-aware)")
    build.add_argument(
        "--target",
        choices=("editor", "template_release", "template_debug"),
        default="editor",
        help="SCons target (default: editor)",
    )
    build.add_argument(
        "--platform",
        choices=("host", "linuxbsd", "windows", "macos"),
        default="host",
        help="cross-compile platform (default: host)",
    )
    build.add_argument(
        "--mingw",
        action="store_true",
        help="use MinGW for a Windows template build",
    )
    build.add_argument(
        "--clean-import",
        action="store_true",
        help="delete the game's .godot cache after an editor build",
    )
    build.set_defaults(func=cmd_build)

    init = sub.add_parser("init", help="add gai project files to a game")
    init.add_argument("path", nargs="?", help="game directory (default: GAI_GAME or game/)")
    init.add_argument("--force", action="store_true", help="overwrite generated files")
    init.add_argument("--no-mcp", action="store_true", help="do not write .gai/mcp.json")
    init.set_defaults(func=cmd_init)

    check = sub.add_parser("check", help="import assets, parse scripts, run the main scene and game tests")
    check.add_argument("--frames", type=int, default=5, help="frames to run (default: 5)")
    check.add_argument("--timeout", type=int, default=120, help="seconds per step (default: 120)")
    check.add_argument("--scene", action="append", default=[], help="run an extra scene, such as res://view/game_level_1/game_level_1.tscn")
    check.add_argument("--no-tests", action="store_true", help="do not run game tests")
    check.set_defaults(func=cmd_check)

    test_cmd = sub.add_parser("test", help="run game tests headlessly")
    test_cmd.add_argument(
        "--filter",
        default="",
        help="run tests whose file::name contains this text",
    )
    test_cmd.add_argument("--dir", default="res://tests", help="test directory (default: res://tests)")
    test_cmd.add_argument("--timeout", type=int, default=300, help="seconds for the test run (default: 300)")
    test_cmd.add_argument("--json", action="store_true", help="print the result as JSON")
    test_cmd.add_argument("--verbose", action="store_true", help="print the engine output")
    test_cmd.add_argument(
        "--scene-dir",
        action="append",
        default=[],
        help="discover and run every .tscn under this res:// directory; repeatable",
    )
    test_cmd.add_argument(
        "--scene-timeout",
        type=float,
        default=120.0,
        help="seconds per scene with --scene-dir (default: 120)",
    )
    test_cmd.add_argument(
        "--scene-frames",
        type=int,
        default=0,
        help="with --scene-dir, pass --quit-after N; 0 lets the scene quit itself",
    )
    test_cmd.add_argument(
        "--isolate",
        action="store_true",
        help="run each test file in a separate engine process",
    )
    test_cmd.add_argument(
        "--isolate-tests",
        action="store_true",
        help="run each test method in a separate engine process",
    )
    test_cmd.add_argument(
        "--file-timeout",
        type=float,
        default=60.0,
        help="seconds per file or test with isolation (default: 60)",
    )
    test_cmd.set_defaults(func=cmd_test)

    run_cmd = sub.add_parser("run", help="run the game")
    run_cmd.add_argument("extra", nargs=argparse.REMAINDER, help="arguments for the engine")
    run_cmd.set_defaults(func=cmd_run)
    export_cmd = sub.add_parser("export", help="export the game")
    export_sub = export_cmd.add_subparsers(dest="export_target", required=True)
    export_web = export_sub.add_parser("web", help="export a web build")
    export_web.add_argument("--preset", default="Web", help="export preset name")
    export_web.add_argument("--output", default="build/web/index.html", help="output html path")
    export_web.add_argument("--clean", action="store_true", help="remove the output directory first")
    export_web.add_argument("--gzip", action="store_true", help="write .gz files for static hosting")
    export_web.add_argument("--timeout", type=int, default=900, help="export timeout in seconds")
    export_web.set_defaults(func=cmd_export_web)

    for native_target, native_default in (("windows", "Windows Desktop"), ("linux", "Linux")):
        native = export_sub.add_parser(native_target, help=f"export a {native_target} build")
        native.add_argument("--preset", default=native_default, help=f"export preset name (default: {native_default})")
        native.add_argument("--output", help="output binary path; defaults to the preset export_path")
        native.add_argument("--clean", action="store_true", help="remove the output directory first when it is inside the game")
        native.add_argument("--timeout", type=int, default=900, help="export timeout in seconds")
        native.add_argument("--archive", help="write a .zip or .tar.gz archive next to the output")
        native.add_argument("--checksum", action="store_true", help="write SHA256SUMS next to the output")
        native.add_argument("--steam-runtime", action="store_true", help="require and copy the Steam runtime")
        native.add_argument("--no-steam-runtime", action="store_true", help="do not copy the Steam runtime")
        native.add_argument("--dry-run", action="store_true", help="preflight and print the export command")
        native.set_defaults(
            func=cmd_export_native,
            export_target=native_target,
            default_preset=native_default,
        )

    editor = sub.add_parser("editor", help="open the game in the Godot editor")
    editor.set_defaults(func=cmd_editor)

    agent = sub.add_parser("agent", help="inspect and edit a running game")
    agent_sub = agent.add_subparsers(dest="agent_command", required=True)
    agent_start = agent_sub.add_parser("start", help="start the game with the bridge")
    agent_start.add_argument(
        "--display",
        action="store_true",
        help="run with a display so render.screenshot works",
    )
    agent_start.add_argument(
        "--editor",
        action="store_true",
        help="start the editor instead of the game",
    )
    agent_start.set_defaults(func=cmd_agent_start)
    agent_stop = agent_sub.add_parser("stop", help="stop the bridge and the game")
    agent_stop.set_defaults(func=cmd_agent_stop)
    agent_status = agent_sub.add_parser("status", help="show the bridge state")
    agent_status.set_defaults(func=cmd_agent_status)
    agent_tree = agent_sub.add_parser("tree", help="print the live scene tree as JSON")
    agent_tree.set_defaults(func=cmd_agent_tree)
    agent_get = agent_sub.add_parser("get", help="read node properties")
    agent_get.add_argument("path", help="node path, for example /root/Main")
    agent_get.add_argument("--property", action="append", default=[], help="property to read; repeatable")
    agent_get.set_defaults(func=cmd_agent_get)
    agent_set = agent_sub.add_parser("set", help="set a node property")
    agent_set.add_argument("path")
    agent_set.add_argument("property")
    agent_set.add_argument("value", help="JSON value, or Godot text such as Vector2(10, 20)")
    agent_set.set_defaults(func=cmd_agent_set)
    agent_call = agent_sub.add_parser("call", help="call any bridge method with JSON params")
    agent_call.add_argument("method")
    agent_call.add_argument("params", nargs="?", default="{}", help="JSON object (default: {})")
    agent_call.set_defaults(func=cmd_agent_call)
    agent_methods = agent_sub.add_parser("methods", help="list bridge methods")
    agent_methods.set_defaults(func=cmd_agent_methods)
    agent_log = agent_sub.add_parser("log", help="tail the game log")
    agent_log.add_argument("--lines", type=int, default=80)
    agent_log.set_defaults(func=cmd_agent_log)
    agent_watch = agent_sub.add_parser("watch", help="stream signal events from the bridge")
    agent_watch_target = agent_watch.add_mutually_exclusive_group(required=True)
    agent_watch_target.add_argument("--path", help="node path, for example /root/Main")
    agent_watch_target.add_argument("--handle", help="object handle from scene.tree or object.singleton")
    agent_watch.add_argument("--signal", required=True, help="signal name")
    agent_watch.add_argument("--count", type=int, default=0, help="stop after N events (default: run until Ctrl-C)")
    agent_watch.set_defaults(func=cmd_agent_watch)

    mcp = sub.add_parser("mcp", help="serve the agent bridge over MCP stdio")
    mcp.add_argument(
        "--start",
        action="store_true",
        help="start the game bridge if it is not running",
    )
    mcp.add_argument(
        "--display",
        action="store_true",
        help="with --start, run with a display so screenshots work",
    )
    mcp.add_argument(
        "--editor",
        action="store_true",
        help="with --start, start the editor instead of the game",
    )
    mcp.add_argument(
        "--timeout",
        type=float,
        default=30.0,
        help="seconds per bridge call (default: 30)",
    )
    mcp.add_argument(
        "--command-timeout",
        type=float,
        default=300.0,
        help="seconds for gai_test and gai_check (default: 300)",
    )
    mcp.set_defaults(func=cmd_mcp)

    engine = sub.add_parser("engine", help="manage the official fallback engine")
    engine_sub = engine.add_subparsers(dest="engine_command", required=True)
    install = engine_sub.add_parser("install", help="download the official fallback engine (no gai features)")
    install.add_argument("--force", action="store_true", help="replace an installed engine")
    install.set_defaults(func=cmd_engine_install)
    engine_path = engine_sub.add_parser("path", help="print the engine path")
    engine_path.set_defaults(func=cmd_engine_path)

    steam = sub.add_parser("steam", help="manage the GodotSteam module and the Steamworks SDK")
    steam_sub = steam.add_subparsers(dest="steam_command", required=True)
    steam_status = steam_sub.add_parser("status", help="show the module, the SDK, and the runtime library")
    steam_status.set_defaults(func=cmd_steam_status)
    steam_sdk = steam_sub.add_parser("sdk", help="install the Steamworks SDK")
    steam_sdk.add_argument("--download", action="store_true", help="download the pinned SDK from a public mirror")
    steam_sdk.add_argument("--from", dest="from_path", help="a Steamworks SDK folder or zip")
    steam_sdk.set_defaults(func=cmd_steam_sdk)
    steam_runtime = steam_sub.add_parser("runtime", help="copy the Steam library next to the engine")
    steam_runtime.set_defaults(func=cmd_steam_runtime)
    steam_vendor = steam_sub.add_parser("vendor", help="refresh modules/godotsteam from a checkout")
    steam_vendor.add_argument("--from", dest="from_path", required=True, help="a GodotSteam checkout")
    steam_vendor.set_defaults(func=cmd_steam_vendor)

    upstream = sub.add_parser("upstream", help="track godotengine/godot")
    upstream_sub = upstream.add_subparsers(dest="upstream_command", required=True)
    status = upstream_sub.add_parser("status", help="show the recorded base and merge state")
    status.set_defaults(func=cmd_upstream_status)
    check_parser = upstream_sub.add_parser(
        "check",
        help="warn about engine changes with no feature owner; --strict fails",
    )
    check_parser.add_argument(
        "--strict",
        action="store_true",
        help="fail on unclaimed engine changes (gai's canonical CI)",
    )
    check_parser.set_defaults(func=cmd_upstream_check)
    report = upstream_sub.add_parser("report", help="list features, changed files, and unclaimed paths")
    report.set_defaults(func=cmd_upstream_report)
    merge = upstream_sub.add_parser("merge", help="fetch and merge an upstream tag")
    merge.add_argument("ref", help="tag or commit to merge")
    merge.add_argument(
        "--strict",
        action="store_true",
        help="fail on engine changes with no feature owner (gai's canonical CI)",
    )
    merge.set_defaults(func=cmd_upstream_merge)
    cont = upstream_sub.add_parser("continue", help="finish a merge after resolving conflicts")
    cont.add_argument(
        "--strict",
        action="store_true",
        help="fail on engine changes with no feature owner",
    )
    cont.set_defaults(func=cmd_upstream_continue)
    abort = upstream_sub.add_parser("abort", help="abort the current merge")
    abort.set_defaults(func=cmd_upstream_abort)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        sys.exit(0)
